---
// Contract address with a copy button — a must-have on any memecoin site.
import { config } from '../lib/project';
const ca = config.ca.trim();
---
<div class="flex w-full max-w-xl items-center gap-3 rounded-card border border-white/10 bg-surface/80 p-2 pl-4 backdrop-blur">
  <span class="shrink-0 text-xs font-black uppercase tracking-wider text-muted">CA</span>
  {ca ? (
    <>
      <code class="min-w-0 flex-1 truncate font-mono text-sm text-ink" title={ca}>{ca}</code>
      <button
        type="button"
        data-copy={ca}
        class="shrink-0 rounded-btn bg-accent px-4 py-2 text-sm font-black text-white transition hover:brightness-110"
      >Copy</button>
    </>
  ) : (
    <span class="flex-1 py-2 text-sm text-muted">Contract address appears here at launch</span>
  )}
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy || '');
      const label = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = label), 1500);
    });
  });
</script>
