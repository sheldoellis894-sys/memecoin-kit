---
import '../styles/global.css';
import { config, theme, asset } from '../lib/project';
import Effects from './Effects.astro';
import Track from './Track.astro';

const c = theme.colors;
const f = theme.fonts;
const tickerFont = f.ticker === 'heading' ? f.heading : f.body;
const htmlClass = [
  theme.flavor && `flavor-${theme.flavor}`,
  typeof (theme as any).decor === 'string' && /^[a-z]+$/.test((theme as any).decor) && `decor-${(theme as any).decor}`,
  f.ticker === 'heading' && 'ticker-heading',
  f.headingScale && 'scale-headings',
  f.headingLeading && 'lead-headings',
  f.bodyScale && 'scale-body',
].filter(Boolean).join(' ') || undefined;
const vars = [
  `--t-bg:${c.bg}`, `--t-surface:${c.surface}`, `--t-text:${c.text}`, `--t-muted:${c.muted}`,
  `--t-primary:${c.primary}`, `--t-on-primary:${c.onPrimary}`, `--t-secondary:${c.secondary}`, `--t-accent:${c.accent}`,
  `--t-font-heading:'${theme.fonts.heading}'`, `--t-font-body:'${theme.fonts.body}'`,
  `--t-radius-button:${theme.radius.button}`, `--t-radius-card:${theme.radius.card}`,
  `--t-font-ticker:'${tickerFont}'`,
  f.headingScale && `--t-heading-scale:${f.headingScale}`,
  f.headingLeading && `--t-heading-leading:${f.headingLeading}`,
  f.headingMin && `--t-heading-min:${f.headingMin}`,
  f.bodyScale && `--t-body-scale:${f.bodyScale}`,
  f.mono && `--t-font-mono:'${f.mono}'`,
  // optional colours of a flavor (theme.json "lights": { "glow": "#FFB52E", … } → --tl-glow); colour values only
  ...Object.entries(theme.lights || {}).filter(([k, v]) => /^[a-zA-Z]+$/.test(k) && typeof v === 'string' && /^#[0-9a-fA-F]{3,8}$/.test(v)).map(([k, v]) => `--tl-${k}:${v}`),
].filter(Boolean).join(';');

const title = `${config.name} ($${config.ticker})`;
// visit and click numbers for /admin, only where the server counts them (config server.functions has "stats")
const track = ((config as any).server?.functions || []).includes('stats');
const og = config.assets.og ? (config.url ? new URL(asset(config.assets.og), config.url).href : asset(config.assets.og)) : '';
---
<!doctype html>
<html lang="en" style={vars} class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {config.tagline}</title>
    <meta name="description" content={config.description} />
    <meta name="theme-color" content={c.bg} />
    <link rel="icon" href={asset(config.assets.favicon || config.assets.logo)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={config.description} />
    {og && <meta property="og:image" content={og} />}
    {config.url && <meta property="og:url" content={config.url} />}
    <meta name="twitter:card" content="summary_large_image" />
    {og && <meta name="twitter:image" content={og} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${theme.fonts.googleFonts}&display=swap`} />
  </head>
  <body class="antialiased">
    <slot />
    <Effects />
    {track && <Track />}
  </body>
</html>
