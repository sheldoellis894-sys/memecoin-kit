---
// Effects of the "paper" flavor (layout "contract"). Put "paperFx" first in the layout.
//   stamps — every click leaves a red ink stamp on the page
//   pen    — red-pen notes write themselves and strike-throughs draw when they scroll into view
//   redact — blacked-out text opens on hover, focus or tap
//   loupe  — a magnifying glass over the fine print
// Each one can be switched off in project.config.json → "paper.fx". All respect "reduce motion".
import { config, theme } from '../../lib/project';
const fx = { stamps: true, pen: true, redact: true, loupe: true, ...(config.paper?.fx || {}) };
const word = config.paper?.stampWord || 'APPROVED';
const hand = theme.fonts.hand || theme.fonts.body;
---
<style set:html={`:root{--t-font-hand:'${hand}'}`}></style>
<script is:inline define:vars={{ fx, word }}>
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.documentElement;
  root.classList.add('pp-js');

  // Paw-print stamp, drawn once and reused
  const stampSvg = `<svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true">
    <g fill="none" stroke="currentColor"><circle cx="50" cy="50" r="46" stroke-width="5"/><circle cx="50" cy="50" r="38" stroke-width="1.6"/></g>
    <g fill="currentColor"><ellipse cx="50" cy="50" rx="13" ry="10.5"/><ellipse cx="33" cy="38" rx="5.6" ry="7.2" transform="rotate(-24 33 38)"/>
    <ellipse cx="44" cy="29" rx="5.6" ry="7.4" transform="rotate(-8 44 29)"/><ellipse cx="57" cy="29" rx="5.6" ry="7.4" transform="rotate(8 57 29)"/>
    <ellipse cx="68" cy="38" rx="5.6" ry="7.2" transform="rotate(24 68 38)"/>
    <text x="50" y="78" text-anchor="middle" font-family="Courier New, monospace" font-weight="700" font-size="${word.length > 8 ? 9 : 11}" letter-spacing="1">${word}</text></g></svg>`;
  window.ppStamp = stampSvg;

  // 1) A stamp on every click
  if (fx.stamps) {
    const placed = [];
    addEventListener('pointerdown', (e) => {
      if (e.button) return;
      const t = e.target;
      if (!(t instanceof Element) || t.closest('a,button,input,canvas,video,summary,[data-nostamp],.pp-redact,.pp-fine')) return;
      const sheet = t.closest('.pp-sheet');
      const host = sheet || document.body;
      const r = sheet ? sheet.getBoundingClientRect() : { left: -scrollX, top: -scrollY };
      const s = document.createElement('span');
      s.className = 'pp-stamp' + (sheet ? '' : ' pp-stamp-desk') + (calm ? '' : ' pp-stamp-in');
      s.style.left = e.clientX - r.left + 'px';
      s.style.top = e.clientY - r.top + 'px';
      s.style.setProperty('--rot', (Math.random() * 50 - 25).toFixed(1) + 'deg');
      s.innerHTML = stampSvg;
      host.appendChild(s);
      placed.push(s);
      if (placed.length > 30) placed.shift().remove();
    });
  }

  addEventListener('DOMContentLoaded', () => {
    // 2) Red pen: notes and strike-throughs appear when they scroll into view
    const pens = document.querySelectorAll('[data-pen]');
    if (fx.pen && !calm && 'IntersectionObserver' in window) {
      root.classList.add('pp-pen-on');
      // A written-on note is clipped until it appears, and a clipped element never counts as "in view".
      // So each note gets an invisible 1px marker in front of it, and the marker is what is being watched.
      const owner = new Map();
      const io = new IntersectionObserver((entries) => entries.forEach((en) => {
        if (!en.isIntersecting) return;
        (owner.get(en.target) || en.target).classList.add('is-written');
        io.unobserve(en.target);
      }), { rootMargin: '0px 0px -14% 0px' });
      pens.forEach((el) => {
        if (!el.classList.contains('pp-pen')) return io.observe(el);
        const mark = document.createElement('span');
        mark.className = 'pp-sentinel'; mark.setAttribute('aria-hidden', 'true');
        el.before(mark); owner.set(mark, el); io.observe(mark);
      });
    }

    // 3) Blacked-out text: tap or Enter toggles it (hover and focus are handled in CSS)
    if (fx.redact) {
      document.querySelectorAll('.pp-redact').forEach((el) => {
        const flip = () => el.classList.toggle('is-open');
        el.addEventListener('click', flip);
        el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });
      });
    }

    // 4) Magnifying glass over the fine print (mouse); a tap simply enlarges the text (touch)
    document.querySelectorAll('.pp-fine').forEach((fine) => {
      fine.addEventListener('click', () => fine.classList.toggle('is-big'));
      if (!fx.loupe || !matchMedia('(pointer: fine)').matches) return;
      const Z = 3, R = 85;
      const lens = document.createElement('div');
      lens.className = 'pp-lens'; lens.setAttribute('aria-hidden', 'true');
      const copy = document.createElement('div');
      copy.className = 'pp-lens-copy';
      lens.appendChild(copy); document.body.appendChild(lens);
      const move = (e) => {
        if (fine.classList.contains('is-big')) { lens.style.display = 'none'; return; }
        const r = fine.getBoundingClientRect();
        copy.style.width = r.width + 'px';
        copy.textContent = fine.textContent;
        copy.style.transform = `translate(${R - (e.clientX - r.left) * Z}px, ${R - (e.clientY - r.top) * Z}px) scale(${Z})`;
        lens.style.display = 'block';
        lens.style.left = e.clientX - R + 'px';
        lens.style.top = e.clientY - R + 'px';
      };
      fine.addEventListener('pointermove', move);
      fine.addEventListener('pointerleave', () => { lens.style.display = 'none'; });
      addEventListener('scroll', () => { lens.style.display = 'none'; }, { passive: true });
    });
  });
</script>
