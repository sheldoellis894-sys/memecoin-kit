---
// A number shown as a mechanical counter: every digit is a wheel that rolls to its value when the block scrolls into view.
// Letters, commas and signs stay still. Without scripts the final value is shown at once.
const { value, class: cls, live } = Astro.props;
const chars = String(value).split('');
---
<span class:list={['vk-odo', cls]} data-vk-in={live ? undefined : ''} data-vk-odo={live ? '' : undefined} aria-label={String(value)}>
  {chars.map((ch, i) => /\d/.test(ch)
    ? <i style={`--d:${ch};--i:${i}`} aria-hidden="true"><b>0<br />1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9</b></i>
    : <span aria-hidden="true">{ch}</span>)}
</span>
