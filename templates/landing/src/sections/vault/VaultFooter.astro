---
// Footer of the "vault" layout: name, links and the short disclaimer line.
import { config, asset } from '../../lib/project';
import { vault } from '../../lib/vault';
const f = vault.footer || {};
const links = [
  config.links.x && { label: 'X', url: config.links.x },
  config.links.telegram && { label: 'Telegram', url: config.links.telegram },
  config.links.pumpfun && { label: 'pump.fun', url: config.links.pumpfun },
  config.links.dexscreener && { label: 'DexScreener', url: config.links.dexscreener },
].filter(Boolean) as { label: string; url: string }[];
---
<footer class="vk-sec vk-footer">
  <div class="vk-in vk-footer-in">
    <div class="vk-footer-brand">
      <img src={asset(config.assets.logo)} alt="" width="48" height="48" loading="lazy" />
      <div>
        <p class="font-heading vk-footer-name">{config.name} <span class="font-ticker">${config.ticker}</span></p>
        <p class="vk-footer-tag">{f.tag}</p>
      </div>
    </div>
    <ul class="vk-footer-links">
      {links.map((l) => <li><a class="vk-btn vk-btn-small vk-btn-ghost" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></li>)}
    </ul>
    <p class="vk-footer-note">{f.note}</p>
  </div>
</footer>
