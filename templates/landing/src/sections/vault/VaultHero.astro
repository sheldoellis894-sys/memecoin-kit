---
// Lock 1 of the "vault" layout: name, ticker, tagline, two buttons, three numbers and the main picture shown whole (16:9).
import { config, asset } from '../../lib/project';
import { vault, lockNo } from '../../lib/vault';
import VkLock from './VkLock.astro';
import VkOdo from './VkOdo.astro';
import VkDraw from './VkDraw.astro';
const h = vault.hero || {};
const stats: { value: string; label: string }[] = h.stats || [];
---
<section id="home" class="vk-sec vk-hero" data-vk-lock={lockNo('home')}>
  <VkDraw name="door" class="vk-bg vk-bg-hero" />
  <div class="vk-in vk-hero-grid">
    <div class="vk-hero-text">
      <VkLock n={lockNo('home')} kicker={config.hero.kicker} title={config.name} level={1} />
      <p class="vk-ticker font-ticker">${config.ticker}</p>
      <p class="vk-lead">{config.tagline}</p>
      <p class="vk-text">{config.hero.text}</p>
      <div class="vk-actions">
        <a class="vk-btn vk-btn-big" href="#split">{h.primary}</a>
        <a class="vk-btn vk-btn-big vk-btn-ghost" href="#door">{h.secondary} <span class="font-ticker">${config.ticker}</span></a>
      </div>
    </div>
    <figure class="vk-fig vk-hero-fig" data-vk-in>
      <img src={asset(config.assets.hero)} alt={h.imageAlt || config.name} width="1600" height="900" />
      <figcaption>{h.figure}</figcaption>
    </figure>
  </div>
  <ul class="vk-in vk-stats">
    {stats.map((s) => <li><VkOdo value={s.value} class="font-heading" /><span>{s.label}</span></li>)}
  </ul>
</section>
