---
// Layout "vault": the whole site is a vault door with ten locks and every section is one lock.
// This section draws everything that stays in place while the page scrolls: the top bar with the lock counter,
// the dial that turns with the scroll (a big one on the right of wide screens, a small one in the bar),
// and the status line at the bottom that reports in short sentences.
// It also runs the shared effects of the layout: locks open as their sections are passed,
// drawings and counters start when they scroll into view.
// Wording comes from config.vault, colors from the theme.
import { config, asset } from '../../lib/project';
import { vault, locks, total, pad } from '../../lib/vault';
const bar = vault.bar || {};
const status = vault.status || {};
const nav = locks.filter((l) => l.nav);
const logo = asset(config.assets.logo);
const data = JSON.stringify({ ids: locks.map((l) => l.id), line: status.line || '', last: status.last || '', start: status.start || '' });
const ticks = Array.from({ length: total }, (_, i) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / total;
  const p = (r: number) => `${(100 + Math.cos(a) * r).toFixed(1)} ${(100 + Math.sin(a) * r).toFixed(1)}`;
  return `M${p(76)}L${p(94)}`;
});
---
<svg width="0" height="0" class="vk-defs" aria-hidden="true" focusable="false">
  <symbol id="vk-key" viewBox="0 0 40 106">
    <path fill-rule="evenodd" d="M20 0a19 19 0 0 1 3 37.8V84h11v4h-4v3h4v4h-4v3h4v4H23v4h-6v-4H6v-4h4v-3H6v-4h4v-3H6v-4h11V37.8A19 19 0 0 1 20 0Zm0 10a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" />
  </symbol>
</svg>

<header class="vk-bar" data-vk-shell={data}>
  <a href="#home" class="vk-brand" aria-label={config.name}>
    <img src={logo} alt="" width="36" height="36" />
    <span class="font-heading">{config.shortName || config.name}</span>
  </a>
  <nav class="vk-nav" aria-label="Sections">
    {nav.map((l) => <a href={`#${l.id}`} data-vk-nav={l.id}>{typeof l.nav === 'string' ? l.nav : l.label}</a>)}
  </nav>
  <p class="vk-count" data-vk-count aria-label={`${bar.label || 'Locks open'}: 0 / ${total}`}>
    <svg class="vk-mini" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
      <circle cx="100" cy="100" r="88" />
      <g data-vk-dial><path d="M100 22V62M100 138v40M22 100h40M138 100h40" /><circle cx="100" cy="100" r="16" class="vk-mini-hub" /></g>
    </svg>
    <span class="vk-count-label">{bar.label || 'Locks open'}</span>
    <span class="vk-odo is-in" aria-hidden="true">
      <i style="--d:0;--i:0"><b>0<br />1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9</b></i><i style="--d:0;--i:1"><b>0<br />1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9</b></i>
    </span>
    <span class="vk-count-of" aria-hidden="true">/ {pad(total)}</span>
  </p>
  <a class="vk-btn vk-btn-small" href={`#${locks[locks.length - 1]?.id || 'door'}`}>{bar.buy || 'Get'} <span class="font-ticker">${config.ticker}</span></a>
</header>

<aside class="vk-rail" aria-hidden="true">
  <svg viewBox="0 0 200 200" focusable="false">
    <circle cx="100" cy="100" r="98" class="vk-rail-rim" />
    {ticks.map((d) => <path d={d} class="vk-rail-tick" data-vk-tick />)}
    <g data-vk-dial>
      <circle cx="100" cy="100" r="64" class="vk-rail-ring" />
      <circle cx="100" cy="100" r="54" class="vk-rail-grad" />
      <path d="M100 30l7 14h-14z" class="vk-rail-pointer" />
      <path d="M100 76v48M76 100h48" class="vk-rail-cross" />
      <circle cx="100" cy="100" r="9" class="vk-rail-hub" />
    </g>
  </svg>
  <p class="vk-rail-label">{vault.railTitle}</p>
</aside>

<div class="vk-status" role="status" aria-live="polite">
  <span class="vk-status-led" aria-hidden="true"></span>
  <span class="vk-status-text" data-vk-status>{status.start}</span>
  <span class="vk-status-pct" data-vk-pct aria-hidden="true">000%</span>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-vk-shell]');
  if (bar) {
    const cfg: { ids: string[]; line: string; last: string; start: string } = JSON.parse(bar.dataset.vkShell!);
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.documentElement;
    root.classList.add('vk-js');
    if (!calm) root.classList.add('vk-motion');

    const total = cfg.ids.length;
    const marks = cfg.ids.map((id) => document.getElementById(id));
    const count = bar.querySelector<HTMLElement>('[data-vk-count]')!;
    const wheels = [...count.querySelectorAll<HTMLElement>('.vk-odo i')];
    const dials = [...document.querySelectorAll<SVGGElement>('[data-vk-dial]')];
    const ticks = [...document.querySelectorAll<SVGPathElement>('[data-vk-tick]')];
    const navLinks = [...bar.querySelectorAll<HTMLAnchorElement>('[data-vk-nav]')];
    const navMarks = navLinks.map((a) => document.getElementById(a.dataset.vkNav!));
    const statusEl = document.querySelector<HTMLElement>('[data-vk-status]')!;
    const pct = document.querySelector<HTMLElement>('[data-vk-pct]')!;

    // ---- Status line: one short sentence. Sections may borrow it for a few seconds (window.vkStatus).
    let base = cfg.start, borrowed = 0;
    const say = (text: string) => {
      if (statusEl.textContent === text) return;
      statusEl.textContent = text;
      if (!calm) { statusEl.classList.remove('is-new'); void statusEl.offsetWidth; statusEl.classList.add('is-new'); }
    };
    (window as any).vkStatus = (text: string, ms = 3200) => {
      clearTimeout(borrowed); say(text);
      borrowed = window.setTimeout(() => { borrowed = 0; say(base); }, ms);
    };

    // ---- Locks: a lock opens when its section has been passed. Opened locks stay open.
    let open = 0, currentNav = -2, queued = false;
    const setOpen = (n: number) => {
      if (n <= open) return;
      open = n;
      const s = String(open).padStart(wheels.length, '0');
      wheels.forEach((w, i) => w.style.setProperty('--d', s[i]));
      count.setAttribute('aria-label', `${count.querySelector('.vk-count-label')?.textContent || ''}: ${open} / ${total}`);
      marks.forEach((el, i) => el?.classList.toggle('is-open', i < open));
      ticks.forEach((t, i) => t.classList.toggle('is-on', i < open));
      base = (open >= total && cfg.last ? cfg.last : cfg.line).replace('{n}', String(open)).replace('{left}', String(total - open));
      if (!borrowed) say(base);
      root.style.setProperty('--vk-open', String(open));
      dispatchEvent(new CustomEvent('vk:locks', { detail: { open, total } }));
    };
    const update = () => {
      queued = false;
      const max = Math.max(1, root.scrollHeight - innerHeight);
      const ratio = Math.min(1, Math.max(0, scrollY / max));
      dials.forEach((d) => { d.style.transform = `rotate(${(ratio * 720).toFixed(1)}deg)`; });
      pct.textContent = `${String(Math.round(ratio * 100)).padStart(3, '0')}%`;
      const mid = innerHeight * 0.55;
      const atEnd = innerHeight + scrollY >= root.scrollHeight - 4;
      let idx = 0;
      marks.forEach((el, i) => { if (el && el.getBoundingClientRect().top < mid) idx = i + 1; });
      if (atEnd) idx = total;   // the last section may be too short to reach the middle of the screen
      setOpen(Math.max(1, idx));
      let n = -1;
      navMarks.forEach((el, i) => { if (el && el.getBoundingClientRect().top < mid) n = i; });
      if (atEnd && navLinks.length) n = navLinks.length - 1;
      if (n !== currentNav) { currentNav = n; navLinks.forEach((a, i) => a.classList.toggle('is-on', i === n)); }
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
    (window as any).vkLocks = { open: () => open, total, update };

    // ---- Shared effects: drawings draw themselves and counters roll when they scroll into view
    const targets = document.querySelectorAll('[data-vk-in]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target); e.target.classList.add('is-in');
      }), { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      targets.forEach((el) => io.observe(el));
    } else {
      targets.forEach((el) => el.classList.add('is-in'));
    }
  }
</script>
