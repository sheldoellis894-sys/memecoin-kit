---
// Footer of the "guide" layout: name, links and the short disclaimer line.
import { config, asset } from '../../lib/project';
import { guide } from '../../lib/guide';
const f = guide.footer || {};
const links = [
  config.links.x && { label: 'X', url: config.links.x },
  config.links.telegram && { label: 'Telegram', url: config.links.telegram },
  config.links.pumpfun && { label: 'pump.fun', url: config.links.pumpfun },
  config.links.dexscreener && { label: 'DexScreener', url: config.links.dexscreener },
].filter(Boolean) as { label: string; url: string }[];
---
<footer class="gd-footer">
  <div class="gd-in gd-footer-in">
    <div class="gd-footer-brand">
      <img src={asset(config.assets.logo)} alt="" width="52" height="52" loading="lazy" />
      <div>
        <p class="font-heading gd-footer-name">{config.name} <span class="font-ticker">${config.ticker}</span></p>
        <p class="gd-footer-tag">{f.tag}</p>
      </div>
    </div>
    <ul class="gd-footer-links">
      {links.map((l) => <li><a class="gd-btn gd-btn-small gd-btn-line" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></li>)}
    </ul>
    <p class="gd-footer-note">{f.note}</p>
  </div>
</footer>
