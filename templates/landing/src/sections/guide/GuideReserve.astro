---
// Last page: the buy button is a table reservation. The visitor fills a short slip (two rows of choices),
// confirms it, and the slip is stamped: the buy link and the contract address are behind it.
// Works from the keyboard; without scripts the plain link below the slip is always there.
import { config } from '../../lib/project';
import { guide } from '../../lib/guide';
import GdHead from './GdHead.astro';
const r = guide.reserve || {};
const rows: { label: string; options: string[] }[] = r.rows || [];
const ca = config.ca.trim();
const url = config.links.pumpfun;
---
<section id="reserve" class="gd-sec gd-sec-red">
  <div class="gd-in gd-narrow">
    <GdHead id="reserve" kicker={r.kicker} title={r.title} light />
    <div class="gd-slip" data-gd-slip>
      <p class="gd-slip-head"><span class="font-heading">{r.slipTitle}</span><span>{r.slipNo}</span></p>
      {rows.map((row, i) => (
        <fieldset class="gd-slip-row">
          <legend>{row.label}</legend>
          <div class="gd-chips">
            {row.options.map((o, j) => (
              <label><input type="radio" name={`gd-slip-${i}`} value={o} checked={j === 0} /><span>{o}</span></label>
            ))}
          </div>
        </fieldset>
      ))}
      <button type="button" class="gd-btn gd-btn-big" data-gd-confirm>{r.confirm}</button>
      <div class="gd-slip-done" data-gd-done hidden>
        <p class="gd-stamp font-heading" aria-hidden="true">{r.stamp}</p>
        <p class="gd-slip-line" data-gd-line data-template={r.line}></p>
        {url
          ? <a class="gd-btn gd-btn-big gd-btn-green" href={url} target="_blank" rel="noopener noreferrer">{r.buy} <span class="font-ticker">${config.ticker}</span></a>
          : <p class="gd-slip-wait">{r.wait}</p>}
        <p class="gd-tag">{r.caLabel || 'Contract address'}</p>
        {ca ? <p class="gd-ca-row"><code>{ca}</code></p> : <p class="gd-ca-empty">{r.caEmpty}</p>}
      </div>
    </div>
    <p class="gd-slip-plain">
      {url
        ? <a href={url} target="_blank" rel="noopener noreferrer">{r.plain}</a>
        : <a href="#how-to-buy">{r.plainWait}</a>}
    </p>
  </div>
</section>
<script>
  const slip = document.querySelector<HTMLElement>('[data-gd-slip]');
  if (slip) {
    const btn = slip.querySelector<HTMLButtonElement>('[data-gd-confirm]')!;
    const done = slip.querySelector<HTMLElement>('[data-gd-done]')!;
    const line = slip.querySelector<HTMLElement>('[data-gd-line]')!;
    btn.addEventListener('click', () => {
      const picks = [...slip.querySelectorAll<HTMLInputElement>('input[type=radio]:checked')].map((i) => i.value);
      line.textContent = (line.dataset.template || '').replace('{a}', picks[0] || '').replace('{b}', picks[1] || '');
      done.hidden = false; btn.hidden = true;
      slip.classList.add('is-done');
      done.querySelector<HTMLElement>('a, p')?.focus?.();
    });
  }
</script>
