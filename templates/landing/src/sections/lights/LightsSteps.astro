---
// How to buy: one list, a diya and a large number for each step (the label "Lamp {n}" stays for screen readers).
import { lights } from '../../lib/lights';
import { config } from '../../lib/project';
import LtHead from './LtHead.astro';
const s = lights.steps || {};
const steps: { title: string; text: string }[] = config.howToBuy || [];
---
<section id="how-to-buy" class="lt-sec lt-steps-sec">
  <div class="lt-in">
    <div class="lt-steps-wrap">
    <LtHead kicker={s.kicker} title={s.title} lead={s.lead} />
    <ol class="lt-steps">
      {steps.map((st, i) => (
        <li class="lt-step" style={`--i:${i}`} data-ul-in>
          <span class="lt-step-diya" aria-hidden="true"><i></i></span>
          <span class="lt-step-num font-heading" aria-hidden="true">{i + 1}</span>
          <h3 class="font-heading"><span class="lt-sr">{(s.step || 'Step {n}').replace('{n}', String(i + 1))}: </span>{st.title}</h3>
          <p>{st.text}</p>
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>
