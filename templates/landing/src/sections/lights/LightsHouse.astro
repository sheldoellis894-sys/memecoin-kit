      p.setup = true;
      const d = new Date(); const pad2 = (x: number) => String(x).padStart(2, '0');
      p.born = `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}T${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
      save(); showSetup(false); h = houseFor(p);
      if (p.name && !nameField.value) nameField.value = p.name;
      say(p.neighbour ? fill(SU.welcomeFriend || 'Welcome! {friend} lives next door and left you a housewarming gift: marigolds.', { friend: p.neighbour.name || 'Your friend' }) : fill(SU.welcome || 'Welcome to your new {style}. Light the first lamp tonight.', { style: styleName(p.family) }));
      refresh();
      ul.fire('ul:house-ready', { family: p.family, wish: p.wish });
    };
    nameIn.addEventListener('input', () => { setupMsg.textContent = ''; });
    nextBtn.addEventListener('click', () => {
      if (step === 1) {
        const raw = nameIn.value.trim();
        if (raw) { const n = K.cleanName(raw); if (!n) { setupMsg.textContent = L.nameRule || 'Use 2 to 18 Latin letters, numbers, spaces, dots or dashes. No links.'; return; } p.name = n; } else p.name = '';
        goStep(2);
      } else if (step === 2) goStep(3);
      else finishSetup();
    });
    backBtn.addEventListener('click', () => goStep(Math.max(1, step - 1)));
    // Skip on the first question keeps a name that was already typed (a wrong one is simply left out)
    $<HTMLButtonElement>('[data-ul-setup-skip]').addEventListener('click', () => {
      if (step === 1) { const n = K.cleanName(nameIn.value.trim()); if (n) p.name = n; }
      finishSetup();
    });
    wishBox.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-wish]'); if (!b) return;
      p.wish = p.wish === b.dataset.wish ? '' : b.dataset.wish!;
      drawWishes(); rebuild();
    });
    styleBox.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-style]'); if (!b) return;
      p.family = b.dataset.style!;
      styleBox.querySelectorAll('[data-style]').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.style === p.family)));
      rebuild();
    });
    // Another house: a new random house on the same street (a new seed). The nights, the album and the name stay;
    // decorations on spots of the old house come back to the box, the ones put anywhere stay where they are.
    $<HTMLButtonElement>('[data-ul-setup-reroll]').addEventListener('click', () => { p = { ...p, seed: K.newSeed(), placed: {} }; drawStyles(); rebuild(); });
    $<HTMLButtonElement>('[data-ul-reroll]').addEventListener('click', () => {
      if (peek) return say(L.peekLocked || 'Turn off the preview to decorate.');
      const back = Object.keys(p.placed).length;
      p = { ...p, seed: K.newSeed(), placed: {} }; sel = ''; closeEdit(false); h = houseFor(p); save();
      say(back ? L.rerolledBack || 'A new house on your street. The decorations from the windows and the roof are back in your box.' : L.rerolled || 'A new house on your street. Not this one? Press again.');
      refresh();
      const onStreet = ul.store.get(STREET_KEY); if (onStreet) post(onStreet);
    });
    // where the visitor is: the server tells the country and city (Vercel, Cloudflare or nginx), the browser tells the time zone
    const locate = async () => {
      if (!cfg.geo) return null;
      try {
        const ctl = new AbortController(); const t = setTimeout(() => ctl.abort(), 2500);
        const res = await fetch(cfg.geo, { signal: ctl.signal }); clearTimeout(t);
        return res.ok ? await res.json() : null;
      } catch { return null; }
    };
    function startSetup() {
      showSetup(true); goStep(1);
      nameIn.value = p.name || '';
      const note = $<HTMLElement>('[data-ul-invite-note]');
      if (p.neighbour) { note.hidden = false; note.textContent = fill(SU.invited || '{friend} invited you. Your house will stand right next to theirs.', { friend: p.neighbour.name || SU.someone || 'A friend' }); }
      refresh();
      locate().then((g) => {
        if (!g) return;
        p.city = K.cleanPlace(g.city || ''); p.country = /^[A-Z]{2}$/.test(g.country || '') ? g.country : '';
        if (p.city) $<HTMLElement>('[data-ul-found]').textContent = fill(SU.found || 'The owl found you near {city}. Now pick your street.', { city: p.city });
        if (setupOn && step === 3) drawStyles();
        save();
      });
    }

    // ---- invites -------------------------------------------------------------------------------
    const inviteLink = () => `${cfg.url || location.origin + location.pathname}?n=${K.encodeInvite(p)}#house`;
    const inviteMsg = $<HTMLElement>('[data-ul-invite-msg]');
    $<HTMLButtonElement>('[data-ul-invite-copy]').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(inviteLink()); inviteMsg.textContent = cfg.invite.copied || 'The link is copied. Send it to a friend.'; }
      catch { inviteMsg.textContent = inviteLink(); }
    });
    $<HTMLButtonElement>('[data-ul-invite-x]').addEventListener('click', () => {
      const q = new URLSearchParams({ text: fill(cfg.invite.text || 'Be my neighbour on the owl\'s street. ${ticker}', { ticker: cfg.ticker }), url: inviteLink() });
      window.open(`https://x.com/intent/post?${q}`, '_blank', 'noopener');
    });
    const setNeighbour = (inv: any) => {
      p.neighbour = { seed: inv.seed, family: inv.family, wish: inv.wish, name: inv.name };
      friend = houseFor(p.neighbour);
    };
    if (invite && invite.seed !== p.seed) {
      // the housewarming marigolds come once: opening invite links again before the house is built gives nothing more
      if (!p.setup) { const first = !p.neighbour; setNeighbour(invite); if (first) { p.inv.marigold = (p.inv.marigold || 0) + 1; p.seen = { ...(p.seen || {}), marigold: ((p.seen || {}).marigold || 0) + 1 }; } save(); }
      else if (!p.neighbour || p.neighbour.seed !== invite.seed) {
        const offer = $<HTMLElement>('[data-ul-invite-offer]');
        offer.hidden = false;
        $<HTMLElement>('[data-ul-invite-offer-text]').textContent = fill(cfg.invite.offer || '{friend} invited you to be neighbours. Their house can stand next to yours.', { friend: invite.name || cfg.setup.someone || 'A friend' });
        $<HTMLButtonElement>('[data-ul-invite-accept]').addEventListener('click', () => { setNeighbour(invite); save(); offer.hidden = true; say(fill(cfg.invite.moved || '{friend} is your neighbour now.', { friend: invite.name || cfg.setup.someone || 'A friend' })); refresh(); });
        $<HTMLButtonElement>('[data-ul-invite-decline]').addEventListener('click', () => { offer.hidden = true; });
      }
    }

    if (!p.setup && !p.nights) startSetup(); else refresh();

    // Test hook: everything the checks need, without clicking through seven real nights.
    (root as any).house = {
      get p() { return p; }, get h() { return h; }, get today() { return today; },
      setToday(key: string) { today = key; pinnedDay = true; refresh(); },
      // lights "today" (see setToday) without the dialog, so a check can walk through the nights
      light: () => { const res = K.lightTonight(p, today, Math.random, ul.holder, ctxNow()); if (res.gift) { p = res.p; save(); refresh(); } return res; },
      lightWith: (ctx: any) => { const res = K.lightTonight(p, today, Math.random, ul.holder, { ...ctxNow(), ...ctx }); if (res.gift) { p = res.p; save(); refresh(); } return res; },
      lightClick: () => light(),
      place(slot: string, item: string) { const n = K.placeItem(withLent(), slot, item, ul.holder); if (n) { p = { ...p, placed: n.placed }; save(); refresh(); } return Boolean(n); },
      select(item: string) { sel = item; refresh(); },
      card, post, moveIn, setPeek,
      reset(seed?: number, family?: string, more: any = {}) { p = K.freshProgress(seed ?? K.newSeed(), family || newHouse(seed).family, { setup: true, ...more }); h = houseFor(p); friend = p.neighbour ? houseFor(p.neighbour) : null; save(); sel = ''; showSetup(false); refresh(); },
      code: () => K.encodeHouse(p.seed, p.placed, p.family, p.wish, { free: p.free, paint: p.paint }),
      placeFree: (item: string, x: number, y: number, more: any = {}) => { const n = K.placeFree(withLent(), item, x, y, ul.holder, more); if (n) { p = { ...p, free: n.free }; save(); refresh(); } return Boolean(n); },
      paint: (item: string) => { const n = K.applyPaint(withLent(), item, ul.holder); if (n) { p = { ...p, paint: n.paint }; save(); refresh(); } return Boolean(n); },
      give: (items: Record<string, number>) => { for (const [i, n] of Object.entries(items)) { p.inv[i] = (p.inv[i] || 0) + n; p.seen = { ...(p.seen || {}), [i]: ((p.seen || {})[i] || 0) + n }; } save(); refresh(); },
      inviteLink, startSetup: () => startSetup(), setupState: () => ({ on: setupOn, step, p }),
    };
  }
</script>
