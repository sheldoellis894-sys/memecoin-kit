---
// The game of the "lights" layout: every visitor gets a unique house built from a seed on the first visit.
// Light up once a night: the owl comes by and leaves something (a new decoration). Decorate the house with what you have.
// Every night in a row the house is brighter and the owl flies closer; a missed night drops the house to level 1;
// on night seven the owl lands on the roof with a sack of fortune. The house is kept in the browser, no wallet, no login.
// The result is saved as a card with a caption for the night, shared on X, or put on the street (section lightsStreet).
// Wording comes from config.house, colours from the theme. Test hook: element.house (see the end of the script).
import { config, asset } from '../../lib/project';
import { houseCfg, owlImages, itemNames, streetCfg, nightCtx } from '../../lib/lights';
import { ITEMS, ITEM_IDS, NIGHTS } from '../../lib/lights-kit.js';
import LtHead from './LtHead.astro';
const c = houseCfg;
const l: Record<string, string> = c.labels || {};
const data = JSON.stringify({
  owl: owlImages, items: itemNames, holderItems: ITEM_IDS.filter((i) => (ITEMS as any)[i].holder),
  captions: c.captions || [], landedCaption: c.landedCaption || '', afterCaption: c.afterCaption || '',
  status: c.status || {}, labels: l, slotNames: c.slotNames || {}, watermark: c.watermark || '', styles: c.styles || [], styleNames: c.styleNames || {},
  shareText: c.shareText || '', url: config.url || '', name: config.name, ticker: config.ticker, file: config.ticker.toLowerCase(),
  endpoint: streetCfg.enabled === false ? '' : streetCfg.endpoint || '/api/street', streetErrors: streetCfg.errors || {},
  holderGift: c.holderGift || { jhoomar: 1, golddiya: 2, 'string-gold': 1, 'paint-goldleaf': 1 }, categories: c.categories || {}, rarityNames: c.rarityNames || {},
  story: c.story || {}, events: c.events || {}, night: nightCtx,
  geo: c.geoEndpoint === '' ? '' : c.geoEndpoint || '/api/geo', wishes: c.wishes || {}, setup: c.setup || {}, invite: c.invite || {},
});
const su: Record<string, string> = c.setup || {};
const iv: Record<string, string> = c.invite || {};
---
<section id="house" class="lt-sec lt-house-sec" data-ul-house={data}>
  <div class="lt-in">
    <LtHead kicker={c.kicker} title={c.title} lead={c.lead} />
    <div class="lt-house">
      <div class="lt-stage" data-ul-in>
        <div class="lt-stage-box">
          <div class="lt-stage-svg" data-ul-svg aria-hidden="true"></div>
          <div class="lt-slots" data-ul-slots></div>
          <p class="lt-stage-tag"><span>{l.house || 'House'}</span> <b data-ul-no>No. —</b></p>
        </div>
        <p class="lt-plate" data-ul-plate></p>
        <p class="lt-tip" data-ul-tip aria-live="polite">{l.tipStart}</p>
      </div>

      <div class="lt-panel" data-ul-in>
        <div class="lt-setup" data-ul-setup hidden>
          <p class="lt-invite-note" data-ul-invite-note hidden></p>
          <p class="lt-label" data-ul-setup-count></p>
          <div class="lt-setup-step" data-step="1">
            <h3 class="font-heading">{su.nameTitle || 'Whose house is this?'}</h3>
            <p class="lt-note">{su.nameNote || 'The name goes on the door, on your cards and on the street. Latin letters and numbers.'}</p>
            <input class="lt-input" data-ul-setup-name maxlength="18" autocomplete="nickname" placeholder={su.namePlaceholder || 'Your name or nickname'} />
          </div>
          <div class="lt-setup-step" data-step="2" hidden>
            <h3 class="font-heading">{su.wishTitle || 'What do you want from the owl?'}</h3>
            <p class="lt-note">{su.wishNote || 'The wish paints your house and changes what the owl brings.'}</p>
            <div class="lt-wishes" data-ul-wishes></div>
          </div>
          <div class="lt-setup-step" data-step="3" hidden>
            <h3 class="font-heading">{su.styleTitle || 'Which street is yours?'}</h3>
            <p class="lt-note" data-ul-found>{su.styleNote || 'The owl flies all over the world. Pick the street where your house stands.'}</p>
            <div class="lt-styles" data-ul-styles></div>
            <button type="button" class="lt-btn lt-btn-ghost lt-btn-small lt-reroll" data-ul-setup-reroll>{su.reroll || 'Show me another house'}</button>
          </div>
          <p class="lt-note" data-ul-setup-msg aria-live="polite"></p>
          <div class="lt-actions lt-actions-tight">
            <button type="button" class="lt-btn lt-btn-ghost lt-btn-small" data-ul-setup-back hidden>{su.back || 'Back'}</button>
            <button type="button" class="lt-btn" data-ul-setup-next>{su.next || 'Next'}</button>
            <button type="button" class="lt-btn lt-btn-ghost lt-btn-small" data-ul-setup-skip>{su.skip || 'Skip, build it now'}</button>
          </div>
        </div>

        <div data-ul-main>
        <div class="lt-invite-offer" data-ul-invite-offer hidden>
          <p data-ul-invite-offer-text></p>
          <div class="lt-actions lt-actions-tight">
            <button type="button" class="lt-btn lt-btn-small" data-ul-invite-accept>{iv.accept || 'Move next to them'}</button>
            <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-invite-decline>{iv.decline || 'No, thanks'}</button>
          </div>
        </div>
        <ol class="lt-nights" data-ul-nights aria-label={l.nightsLabel || 'Nights in a row'}>
          {Array.from({ length: NIGHTS }, (_, i) => <li><span class="lt-sr">{i + 1}</span></li>)}
        </ol>
        <p class="lt-status" data-ul-status aria-live="polite"></p>
        <div class="lt-story" data-ul-story>
          <p class="lt-label">{l.tonightTitle || 'Tonight on your street'}</p>
          <p data-ul-story-night></p>
          <p class="lt-story-event" data-ul-story-event></p>
        </div>
        <button type="button" class="lt-btn lt-btn-big lt-light-btn" data-ul-light data-ul-track="play">{l.light || 'Light up tonight'}</button>
        {owlImages.sleep && (houseCfg as any).hide !== false && <p class="lt-found-hint" data-ul-found-hint>{l.foundHint || 'Every day the owl naps somewhere on this page. Find him and he leaves a gift.'}</p>}

        <div class="lt-box lt-inv-box" data-ul-invbox>
          <p class="lt-label">{l.inventory || 'What you have'} <span data-ul-inv-count></span></p>
          <div class="lt-tabs" data-ul-tabs role="tablist" aria-label={l.inventory || 'What you have'}></div>
          <div class="lt-inv" data-ul-inv></div>
          <p class="lt-note">{l.invHint || 'Tap a decoration: it appears on the house. Drag it, pull a corner to resize, pull the round handle to turn it.'}</p>
        </div>

        <div class="lt-box lt-edit" data-ul-edit hidden>
          <p class="lt-label" data-ul-edit-name></p>
          <label class="lt-range"><span>{l.size || 'Size'}</span><input type="range" min="40" max="400" value="100" data-ul-edit-size /></label>
          <label class="lt-range"><span>{l.turn || 'Turn'}</span><input type="range" min="-180" max="180" value="0" data-ul-edit-turn /></label>
          <label class="lt-range" data-ul-edit-text-row hidden><span>{l.signText || 'Words'}</span><input class="lt-input" maxlength="14" data-ul-edit-text placeholder={l.signPlaceholder || 'Up to 14 letters'} /></label>
          <div class="lt-actions lt-actions-tight">
            <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-edit-act="copy">{l.copyBtn || 'One more'}</button>
            <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-edit-act="front">{l.front || 'Bring to front'}</button>
            <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-edit-act="back">{l.takeBackBtn || 'Remove'}</button>
            <button type="button" class="lt-btn lt-btn-small" data-ul-edit-act="done">{l.done || 'Done'}</button>
          </div>
        </div>

        <dl class="lt-stats">
          <div><dt>{l.statNights || 'Nights lit'}</dt><dd data-ul-stat="nights">0</dd></div>
          <div><dt>{l.statGifts || 'Owl visits'}</dt><dd data-ul-stat="gifts">0</dd></div>
          <div><dt>{l.statBest || 'Best run'}</dt><dd data-ul-stat="best">0</dd></div>
          <div><dt>{l.statLight || 'Brightness'}</dt><dd data-ul-stat="light">0%</dd></div>
        </dl>

        <details class="lt-more lt-album" data-ul-album-box>
          <summary><span>{l.albumTitle || 'Collection album'}</span> <b data-ul-album-count></b></summary>
          <div class="lt-album-in" data-ul-album></div>
        </details>

        <details class="lt-more lt-diary">
          <summary>{l.diaryTitle || 'Street diary'}</summary>
          <ol class="lt-diary-list" data-ul-diary></ol>
        </details>

        <div class="lt-actions lt-actions-tight">
          <button type="button" class="lt-btn" data-ul-card data-ul-track="save">{l.card || 'Save the card'}</button>
          <button type="button" class="lt-btn lt-btn-ghost" data-ul-share data-ul-track="share">{l.share || 'Share on X'}</button>
          <button type="button" class="lt-btn lt-btn-ghost" data-ul-peek aria-pressed="false" hidden>{l.peek || 'Peek at night 7'}</button>
          <button type="button" class="lt-btn lt-btn-ghost" data-ul-reroll>{l.reroll || 'Another house'}</button>
        </div>
        <p class="lt-note" data-ul-peek-note hidden>{l.peekNote || 'This is how night seven looks. Your own nights are not changed.'}</p>

        <div class="lt-tray" data-ul-tray hidden>
          <img data-ul-out alt={l.cardAlt || 'Your house card'} width="1080" height="1080" />
          <div class="lt-actions lt-actions-tight">
            <a class="lt-btn lt-btn-small" data-ul-download download>{l.download || 'Download'}</a>
            <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-share2 data-ul-track="share">{l.share || 'Share on X'}</button>
          </div>
          <p class="lt-note" data-ul-share-note hidden>{l.shareNote || 'X opens with the text ready. Attach the card you downloaded.'}</p>
        </div>

        <details class="lt-more">
          <summary>{l.more || 'Street, house code and holders'}</summary>
          <div class="lt-more-in">
            <form class="lt-form" data-ul-post>
              <label class="lt-label" for="ul-name">{l.streetTitle || 'Put your house on the street'}</label>
              <div class="lt-row">
                <input id="ul-name" class="lt-input" name="name" maxlength="18" autocomplete="nickname" placeholder={l.namePlaceholder || 'Name on the door'} required />
                <button type="submit" class="lt-btn lt-btn-small">{l.post || 'Put it there'}</button>
              </div>
              <p class="lt-note" data-ul-post-note>{l.postNote || 'Latin letters and numbers. Only the house, its name and its nights go to the street.'}</p>
            </form>
            <div class="lt-form">
              <p class="lt-label">{l.codeTitle || 'House code'}</p>
              <p class="lt-note">{l.codeNote || 'The house lives in this browser. Copy the code to move the house to another phone; the nights start there again.'}</p>
              <div class="lt-row">
                <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-copy>{l.copy || 'Copy code'}</button>
                <input class="lt-input" data-ul-code-in placeholder={l.codePlaceholder || 'Paste a code'} />
                <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-restore>{l.restore || 'Move in'}</button>
              </div>
              <p class="lt-note" data-ul-code-note aria-live="polite"></p>
            </div>
            <div class="lt-form">
              <p class="lt-label">{iv.title || 'Invite a neighbour'}</p>
              <p class="lt-note">{iv.note || 'Send the link to a friend: their house will stand next to yours, and they get a housewarming gift.'}</p>
              <div class="lt-row">
                <button type="button" class="lt-btn lt-btn-small" data-ul-invite-copy>{iv.copy || 'Copy the link'}</button>
                <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-invite-x data-ul-track="share">{iv.share || 'Invite on X'}</button>
              </div>
              <p class="lt-note" data-ul-invite-msg aria-live="polite"></p>
            </div>
            <div class="lt-holder">
              <label class="lt-switch">
                <input type="checkbox" role="switch" data-ul-holder />
                <span class="lt-switch-track" aria-hidden="true"><i></i></span>
                <span>{l.holder || 'Holder preview'}</span>
              </label>
              <p class="lt-note">{l.holderNote || 'A preview: golden decorations and a clean card, without a wallet check.'}</p>
            </div>
          </div>
        </details>
        </div>
      </div>
    </div>
  </div>

  <dialog class="lt-gift" data-ul-gift aria-labelledby="ul-gift-title">
    <div class="lt-gift-in">
      <img data-ul-gift-img alt="" width="160" height="160" />
      <ul class="lt-gift-list" data-ul-gift-list hidden></ul>
      <p class="lt-kicker" data-ul-gift-kicker></p>
      <h3 id="ul-gift-title" class="font-heading" data-ul-gift-title></h3>
      <p data-ul-gift-note></p>
      <p class="lt-gift-event" data-ul-gift-event></p>
      <p class="lt-gift-bonus" data-ul-gift-bonus></p>
      <form method="dialog"><button class="lt-btn" data-ul-gift-ok>{l.giftOk || 'Put it on the house'}</button></form>
    </div>
  </dialog>
</section>

<script>
  import * as K from '../../lib/lights-kit.js';

  const root = document.querySelector<HTMLElement>('[data-ul-house]');
  const ul: any = (window as any).ul;
  if (root && ul) {
    const cfg = JSON.parse(root.dataset.ulHouse!);
    const L: Record<string, string> = cfg.labels;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const fill = (t: string, v: Record<string, string | number>) => (t || '').replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
    const KEY = `ul-house-${cfg.file}`;
    const ID_KEY = `ul-id-${cfg.file}`;
    const STREET_KEY = `ul-street-${cfg.file}`;   // the name, once the house stands on the street
    const css = getComputedStyle(document.documentElement);
    const heading = `${css.getPropertyValue('--t-font-heading').trim() || 'sans-serif'}, system-ui, sans-serif`;
    const body = `${css.getPropertyValue('--t-font-body').trim() || 'sans-serif'}, system-ui, sans-serif`;

    // ---- state -----------------------------------------------------------------------------
    // A new visitor gets one of the Indian streets (or one of config.house.styles), picked by the seed; the first-visit
    // questions let them choose another. ?style=<street> in the address shows that street (for demos); it changes only
    // a house without nights, and keeps its name, wish and neighbour.
    const styleList: string[] = Array.isArray(cfg.styles) && cfg.styles.length ? cfg.styles.filter((f: string) => K.FAMILY_IDS.includes(f)) : K.FAMILY_IDS;
    const askStyle = new URLSearchParams(location.search).get('style') || '';
    const newHouse = (seed = K.newSeed()) => K.freshProgress(seed, styleList.includes(askStyle) ? askStyle : styleList[(seed >>> 3) % styleList.length]);
    const stored = ul.store.get(KEY);
    let p = stored ? K.readProgress(stored) : newHouse();
    if (!styleList.includes(p.family) && !p.nights) p = { ...p, family: styleList[(p.seed >>> 3) % styleList.length], placed: {}, free: [] };
    if (stored && styleList.includes(askStyle) && p.family !== askStyle && !p.nights) p = { ...p, family: askStyle, placed: {}, free: [] };
    // an invite link (?n=…): the friend's house stands next door. The parameter is taken out of the address at once.
    const params = new URLSearchParams(location.search);
    const invite = params.get('n') ? K.decodeInvite(params.get('n')) : null;
    if (params.has('n')) { params.delete('n'); const q = params.toString(); history.replaceState(null, '', location.pathname + (q ? `?${q}` : '') + location.hash); }
    const houseFor = (q: any) => K.houseOfP({ ...q, paint: q.paint && (!isHolderItemRaw(q.paint) || ul.holder) ? q.paint : '' });
    function isHolderItemRaw(id: string) { return Boolean((K.ITEMS as any)[id]?.holder); }
    let h = houseFor(p);
    let friend = p.neighbour ? houseFor(p.neighbour) : null;
    let today = K.dayKey();
    let pinnedDay = false;   // set by the test hook
    let sel = '';
    let peek = false;
    const save = () => ul.store.set(KEY, JSON.stringify(p));
    if (!stored) save();
    const owlSrc: Record<string, string> = { fly: cfg.owl.fly || K.owlPlaceholder('fly'), landed: cfg.owl.landed || K.owlPlaceholder('landed'), sleep: cfg.owl.sleep || '' };
    const itemName = (id: string) => cfg.items[id]?.name || id;
    const isHolderItem = (id: string) => cfg.holderItems.includes(id);
    // In the holder preview the golden decorations are lent to the house; they are not stored as owned.
    const lent = () => (ul.holder ? cfg.holderGift : {});
    const withLent = () => { const inv = { ...p.inv }; for (const [i, n] of Object.entries(lent())) inv[i] = (inv[i] || 0) + (n as number); return { ...p, inv }; };
    // what goes to the street: golden holder decorations stay at home (there is no wallet check)
    const ownPlaced = () => Object.fromEntries(Object.entries(p.placed).filter(([, i]) => !isHolderItem(i as string)));
    const shownPlaced = () => (ul.holder ? p.placed : Object.fromEntries(Object.entries(p.placed).filter(([, i]) => !isHolderItem(i as string))));
    const ownFree = () => (p.free || []).filter((f: any) => !isHolderItem(f.i));
    const shownFree = () => (ul.holder ? p.free || [] : ownFree());
    const ownPaint = () => (p.paint && !isHolderItem(p.paint) ? p.paint : '');
    const drawCtx: Record<string, any> = { ticker: cfg.ticker, ...cfg.night, time: K.timeOfDay() };

    const view = () => {
      const s = K.statusOf(p, today);
      if (peek) return { ...s, level: K.NIGHTS, landed: true, streak: K.NIGHTS, litTonight: true, due: false, missed: false };
      return s;
    };
    const levelShown = (s: any) => (s.first && s.due ? 0 : s.level);
    const owlFor = (s: any) => {
      // by day the owl sleeps on the roof (unless he has landed for night seven); he flies only in the evening and at night
      if (drawCtx.time === 'day' && !s.landed && owlSrc.sleep) { const pp = K.owlPlace(h, K.NIGHTS, true); return { ...pp, size: 120, pose: 'sleep', href: owlSrc.sleep }; }
      const pos = s.landed ? K.owlPlace(h, K.NIGHTS, true) : K.owlPlace(h, s.litTonight ? s.streak : Math.max(1, s.streak), false);
      return { ...pos, href: owlSrc[pos.pose] };
    };

    // ---- the house on the page ---------------------------------------------------------------
    const svgBox = $<HTMLElement>('[data-ul-svg]');
    const slotsBox = $<HTMLElement>('[data-ul-slots]');
    const tip = $<HTMLElement>('[data-ul-tip]');
    const say = (t: string) => { tip.textContent = t; };
    const SLOT_NAMES: Record<string, string> = { line: 'roof edge', balcony: 'balcony rail', door: 'door', step: 'doorstep', side: 'porch', sill: 'window sill', hang: 'window top', roof: 'roof', win: 'window' };
    // a line slot on a balcony (id b1-line, b2-line…) is the balcony rail, not the roof edge
    const slotLabel = (sl: any) => { const k = sl.kind === 'line' && /^b\d/.test(sl.id) ? 'balcony' : sl.kind; return cfg.slotNames[k] || SLOT_NAMES[k] || k; };

    const timeName = (t: string) => (t === 'day' ? L.timeDay || 'Day' : t === 'dusk' ? L.timeDusk || 'Evening' : L.timeNight || 'Night');
    const drawHouse = () => {
      drawCtx.time = K.timeOfDay();
      const s = view();
      const setupLevel = setupOn ? 2 : levelShown(s);
      const scene = setupOn || peek ? '' : K.sceneOf(K.tonightOf(p, today)?.event || '');
      h = houseFor(p);
      svgBox.innerHTML = K.houseSvg(h, shownPlaced(), { level: setupLevel, owl: setupOn ? null : owlFor(s), slotsFor: sel, id: 'ulh', friend, scene, free: shownFree(), ctx: drawCtx });
      slotsBox.innerHTML = '';
      const placed = shownPlaced();
      for (const sl of h.slots) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'lt-slot'; b.dataset.slot = sl.id;
        const x = sl.kind === 'line' || sl.kind === 'door' ? (sl.x1 + sl.x2) / 2 : sl.x;
        // a window slot covers the upper part of its window (the sill below it is a slot of its own)
        const y = sl.kind === 'line' || sl.kind === 'door' ? sl.y + 10 : sl.kind === 'step' ? sl.y : sl.kind === 'win' ? sl.y + sl.h * 0.38 : sl.y - 14;
        b.style.left = `${(x / K.VIEW) * 100}%`; b.style.top = `${(y / K.VIEW) * 100}%`;
        if (sl.kind === 'line' || sl.kind === 'door') b.style.width = `${((sl.x2 - sl.x1) / K.VIEW) * 100}%`;
        if (sl.kind === 'win') { b.style.width = `${(sl.w / K.VIEW) * 100}%`; b.style.height = `${((sl.h * 0.72) / K.VIEW) * 100}%`; b.style.borderRadius = '8px'; }
        b.classList.toggle('is-line', sl.kind === 'line' || sl.kind === 'door');
        const it = placed[sl.id];
        if (!it) continue;   // only the filled spots are shown: a tap takes the decoration back
        b.classList.add('has-item');
        b.setAttribute('aria-label', `${slotLabel(sl)}: ${itemName(it as string)}. ${L.takeBack || 'Take it back'}`);
        slotsBox.appendChild(b);
      }
      // handles of the decorations put anywhere: drag to move, tap to edit; the selected one gets a frame instead
      for (const f of shownFree()) {
        if (f.n === editN) continue;
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'lt-free'; b.dataset.free = String(f.n);
        b.classList.toggle('is-on', editN === f.n);
        b.style.left = `${(f.x / K.VIEW) * 100}%`; b.style.top = `${(f.y / K.VIEW) * 100}%`;
        b.style.setProperty('--fs', String(f.s));
        b.setAttribute('aria-label', `${itemName(f.i)}. ${L.editIt || 'Move or change it'}`);
        slotsBox.appendChild(b);
      }
      drawFrame();
      $<HTMLElement>('[data-ul-no]').textContent = `No. ${h.no} · ${styleName(h.family)} · ${timeName(drawCtx.time)}`;
      $<HTMLElement>('[data-ul-plate]').textContent = plateText();
    };

    // ---- the frame on the selected decoration: drag inside to move, a corner to resize, the round handle to turn ----
    // While a finger or the mouse holds it, only that decoration moves (its group in the picture), the house is not redrawn.
    let frameBox: { x: number; y: number; w: number; h: number } | null = null;
    const gOf = (n: number) => svgBox.querySelector<SVGGElement>(`[data-fn="${n}"]`);
    const placeFrame = (f: any) => {
      const el = slotsBox.querySelector<HTMLElement>('.lt-sel'); if (!el || !frameBox) return;
      const k = slotsBox.clientWidth / K.VIEW, a = (f.r * Math.PI) / 180;
      const lx = (frameBox.x + frameBox.w / 2) * f.s, ly = (frameBox.y + frameBox.h / 2) * f.s;
      const cx = f.x + lx * Math.cos(a) - ly * Math.sin(a), cy = f.y + lx * Math.sin(a) + ly * Math.cos(a);
      el.style.left = `${cx * k}px`; el.style.top = `${cy * k}px`;
      el.style.width = `${Math.max(28, frameBox.w * f.s * k + 14)}px`; el.style.height = `${Math.max(28, frameBox.h * f.s * k + 14)}px`;
      el.style.transform = `translate(-50%, -50%) rotate(${f.r}deg)`;
    };
    const moveG = (f: any) => { gOf(f.n)?.setAttribute('transform', `translate(${f.x} ${f.y}) rotate(${Math.round(f.r)}) scale(${f.s.toFixed(2)})`); };
    function drawFrame() {
      const f = editN ? freeOf(editN) : null, g = f ? gOf(f.n) : null;
      if (!f || !g || peek) { frameBox = null; return; }
      try { const b = g.getBBox(); frameBox = { x: b.x, y: b.y, w: b.width, h: b.height }; } catch { frameBox = { x: -30, y: -30, w: 60, h: 60 }; }
      const el = document.createElement('div'); el.className = 'lt-sel'; el.dataset.sel = String(f.n);
      el.innerHTML = '<i data-h="nw"></i><i data-h="ne"></i><i data-h="sw"></i><i data-h="se"></i><b data-h="turn" aria-hidden="true"></b>';
      el.setAttribute('aria-label', `${itemName(f.i)}. ${L.editIt || 'Move or change it'}`);
      slotsBox.appendChild(el); placeFrame(f);
    }
    let gesture: any = null;
    const toView = (e: PointerEvent) => { const r = slotsBox.getBoundingClientRect(); return { x: ((e.clientX - r.left) / r.width) * K.VIEW, y: ((e.clientY - r.top) / r.height) * K.VIEW }; };
    slotsBox.addEventListener('pointerdown', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.lt-sel'); if (!el || peek) return;
      const f = freeOf(Number(el.dataset.sel)); if (!f) return;
      e.preventDefault(); e.stopPropagation(); el.setPointerCapture(e.pointerId);
      const pt = toView(e), mode = (e.target as HTMLElement).dataset.h ? ((e.target as HTMLElement).dataset.h === 'turn' ? 'turn' : 'size') : 'move';
      gesture = { el, n: f.n, mode, pt, f0: { ...f }, d0: Math.max(4, Math.hypot(pt.x - f.x, pt.y - f.y)), a0: Math.atan2(pt.y - f.y, pt.x - f.x), moved: false };
    }, true);
    slotsBox.addEventListener('pointermove', (e) => {
      if (!gesture) return;
      const g = gesture, pt = toView(e), f0 = g.f0;
      let q: any;
      if (g.mode === 'move') q = { x: f0.x + pt.x - g.pt.x, y: f0.y + pt.y - g.pt.y };
      else if (g.mode === 'size') q = { s: f0.s * (Math.hypot(pt.x - f0.x, pt.y - f0.y) / g.d0) };
      else { let r = f0.r + ((Math.atan2(pt.y - f0.y, pt.x - f0.x) - g.a0) * 180) / Math.PI; r = ((r + 540) % 360) - 180; q = { r }; }
      if (Math.abs(pt.x - g.pt.x) + Math.abs(pt.y - g.pt.y) > 2) g.moved = true;
      p = K.updateFree(p, g.n, q);
      const f = freeOf(g.n); if (f) { moveG(f); placeFrame(f); eSize.value = String(Math.round(f.s * 100)); eTurn.value = String(f.r); }
    }, true);
    const endGesture = () => { if (!gesture) return; const moved = gesture.moved; gesture = null; dragged = true; setTimeout(() => { dragged = false; }, 0); if (moved) { save(); refresh(); } };
    slotsBox.addEventListener('pointerup', endGesture, true);
    slotsBox.addEventListener('pointercancel', endGesture, true);

    slotsBox.addEventListener('click', (e) => {
      if (peek) return say(L.peekLocked || 'Turn off the preview to decorate.');
      if (dragged) { dragged = false; return; }
      if ((e.target as HTMLElement).closest('[data-free], .lt-sel')) return;
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-slot]');
      if (!b) { if (editN) closeEdit(); return; }
      const id = b.dataset.slot!;
      const it = shownPlaced()[id];
      if (it) { const n = K.placeItem(p, id, ''); if (n) { p = n; save(); say(fill(L.tookBack || '{item}: taken off the house.', { item: itemName(it as string) })); refresh(); } }
    });

    // a tap on a decoration in the box puts it on the house at once: on the front of the house (garlands under the roof),
    // a little apart from the last one; window decorations go into the first empty window
    let cascade = 0;
    const putOnHouse = (id: string) => {
      const it = (K.ITEMS as any)[id];
      if (!it.free) {
        const sl = h.slots.find((x: any) => x.kind === 'win' && !p.placed[x.id]) || h.slots.find((x: any) => it.kinds.includes(x.kind) && !p.placed[x.id]);
        if (!sl) return say(L.winsFull || 'Every window has something in it. Tap one to take it out.');
        const n = K.placeItem(withLent(), sl.id, id, ul.holder); if (!n) return say(fill(L.allPlaced || 'No free {item} left.', { item: itemName(id) }));
        p = { ...p, placed: n.placed }; save(); say(fill(L.inWindow || '{item}: in the window. Tap it to take it out.', { item: itemName(id) })); return refresh();
      }
      cascade = (cascade + 1) % 6;
      const line = ['string', 'flags', 'marigold', 'toran', 'pompom', 'tassel'].some((t) => it.type.startsWith(t)) || it.kinds.includes('line');
      const x = h.cx + ((cascade % 3) - 1) * 70, y = line ? h.top + 8 + Math.floor(cascade / 3) * 40 : h.top + (548 - h.top) * 0.42 + Math.floor(cascade / 3) * 50;
      const n = K.placeFree(withLent(), id, x, y, ul.holder, { t: it.custom ? 'HOOT' : undefined });
      if (!n) return say((p.free || []).length >= K.FREE_MAX ? L.freeFull || 'That is a lot of decorations. Remove some first.' : fill(L.allPlaced || 'No free {item} left.', { item: itemName(id) }));
      p = { ...p, free: n.free }; save();
      say(fill(L.placedFree || '{item} is on the house. Drag it, pull a corner to resize, the round handle to turn.', { item: itemName(id) }));
      openEdit(p.free[p.free.length - 1].n);
    };

    // ---- inventory ---------------------------------------------------------------------------
    const inv = $<HTMLElement>('[data-ul-inv]');
    const tabs = $<HTMLElement>('[data-ul-tabs]');
    const thumbCache: Record<string, string> = {};
    const thumb = (id: string) => (thumbCache[id] ||= K.svgUrl(K.itemSvg(id, 72, drawCtx)));
    const catName = (c: string) => cfg.categories[c] || c.charAt(0).toUpperCase() + c.slice(1);
    let tab = 'all';
    const drawInv = () => {
      const free = K.freeItems(withLent());
      const owned = withLent().inv;
      // every decoration there is, in the order of the catalogue: the open and owned ones in colour,
      // the ones the owl has not brought yet in grey with a lock, the golden holder ones with a star
      const ids = K.ITEM_IDS;
      const has = (id: string) => (K.isOpen(id) || owned[id] > 0) && (!isHolderItem(id) || ul.holder);
      const cats = K.CATEGORIES.filter((c: string) => ids.some((id: string) => (K.ITEMS as any)[id].cat === c));
      if (tab !== 'all' && !cats.includes(tab)) tab = 'all';
      tabs.innerHTML = '';
      for (const c of ['all', ...cats]) {
        const b = document.createElement('button'); b.type = 'button'; b.setAttribute('role', 'tab'); b.dataset.tab = c;
        b.setAttribute('aria-selected', String(tab === c)); b.textContent = c === 'all' ? L.tabAll || 'All' : catName(c);
        tabs.appendChild(b);
      }
      tabs.hidden = cats.length < 2;
      inv.innerHTML = '';
      for (const id of ids) {
        const it = (K.ITEMS as any)[id];
        if (tab !== 'all' && it.cat !== tab) continue;
        const b = document.createElement('button');
        b.type = 'button'; b.className = `lt-item is-${it.rarity}`; b.dataset.item = id;
        b.setAttribute('aria-pressed', String(p.paint === id));
        const got = has(id);
        b.classList.toggle('is-locked', !got);
        b.classList.toggle('is-holder', isHolderItem(id) && !ul.holder);
        b.classList.toggle('is-empty', got && !free[id] && p.paint !== id);
        b.innerHTML = `<img src="${thumb(id)}" alt="" width="56" height="56" loading="lazy"><span class="lt-item-name"></span>${got && !K.isOpen(id) ? `<b class="lt-item-n">${free[id] || 0}</b>` : ''}`;
        b.querySelector('.lt-item-name')!.textContent = itemName(id);
        inv.appendChild(b);
      }
      if (!inv.children.length) inv.innerHTML = `<p class="lt-note">${L.invEmpty || ''}</p>`;
      const total = Object.entries(free).reduce((a: number, [i, b]: [string, any]) => a + (K.isOpen(i) ? 0 : b), 0);
      $<HTMLElement>('[data-ul-inv-count]').textContent = total ? `· ${total}` : '';
    };
    tabs.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]'); if (!b) return; tab = b.dataset.tab!; drawInv(); });
    inv.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-item]'); if (!b) return;
      const id = b.dataset.item!, it = (K.ITEMS as any)[id];
      if (isHolderItem(id) && !ul.holder) { say(L.holderOnly || 'Golden decorations are for holders. Turn on the holder preview below.'); return; }
      if (!K.isOpen(id) && !(withLent().inv[id] > 0)) { say(fill(L.locked || '{item} is not yours yet. The owl brings it: light your house every night.', { item: itemName(id) })); return; }
      if (peek) return say(L.peekLocked || 'Turn off the preview to decorate.');
      // a can of paint is used at once: the walls change colour; tapping the same can again takes the paint off
      if (it.type === 'paint') {
        const n = K.applyPaint(withLent(), p.paint === id ? '' : id, ul.holder);
        if (!n) return say(fill(L.allPlaced || 'No free {item} left.', { item: itemName(id) }));
        p = { ...p, paint: n.paint }; save(); sel = '';
        say(p.paint ? fill(L.painted || '{item}: the walls are new. Tap the can again to take the paint off.', { item: itemName(id) }) : L.unpainted || 'The paint is off. The house has its own colour again.');
        return refresh();
      }
      if (!K.freeItems(withLent())[id]) { say(fill(L.allPlaced || 'No free {item} left. Remove one from the house first.', { item: itemName(id) })); return; }
      putOnHouse(id);
    });

    // ---- phones: the decorations and the editing box go right under the picture -----------------
    // so picking a decoration and putting it on the house happen on one screen, without scrolling up and down.
    // On a computer they stay in the panel next to the picture. Placeholders keep their places for the way back.
    {
      const phone = matchMedia('(max-width: 939px)');
      const stageCol = root.querySelector<HTMLElement>('.lt-stage')!;
      const moved = [root.querySelector<HTMLElement>('[data-ul-invbox]')!, root.querySelector<HTMLElement>('[data-ul-edit]')!];
      const marks = moved.map((el) => { const m = document.createComment('dock'); el.before(m); return m; });
      const dock = () => {
        moved.forEach((el, i) => { if (phone.matches) stageCol.appendChild(el); else marks[i].after(el); });
        root.classList.toggle('is-docked', phone.matches);
      };
      dock(); phone.addEventListener('change', dock);
    }

    // ---- decorations put anywhere: drag, size, turn, words --------------------------------------
    let editN = 0, dragged = false;
    const editBox = $<HTMLElement>('[data-ul-edit]');
    const eSize = $<HTMLInputElement>('[data-ul-edit-size]');
    const eTurn = $<HTMLInputElement>('[data-ul-edit-turn]');
    const eText = $<HTMLInputElement>('[data-ul-edit-text]');
    const freeOf = (n: number) => (p.free || []).find((f: any) => f.n === n);
    function openEdit(n: number) {
      const f = freeOf(n); if (!f) return;
      editN = n; editBox.hidden = false;
      $<HTMLElement>('[data-ul-edit-name]').textContent = itemName(f.i);
      eSize.value = String(Math.round(f.s * 100)); eTurn.value = String(f.r);
      const custom = Boolean((K.ITEMS as any)[f.i].custom);
      $<HTMLElement>('[data-ul-edit-text-row]').hidden = !custom; if (custom) eText.value = f.t || '';
      refresh();
    }
    function closeEdit(redraw = true) { editN = 0; editBox.hidden = true; if (redraw) refresh(); }
    let raf = 0;
    const patch = (q: any, redraw = true) => { if (!editN) return; p = K.updateFree(p, editN, q); save(); if (redraw) { cancelAnimationFrame(raf); raf = requestAnimationFrame(drawHouse); } };
    eSize.addEventListener('input', () => patch({ s: Number(eSize.value) / 100 }));
    eTurn.addEventListener('input', () => patch({ r: Number(eTurn.value) }));
    eText.addEventListener('input', () => { patch({ t: eText.value }); });
    eText.addEventListener('change', () => { const f = freeOf(editN); if (f) eText.value = f.t || ''; });
    editBox.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-ul-edit-act]')?.dataset.ulEditAct; if (!act || !editN) return;
      const f = freeOf(editN); if (!f) return closeEdit();
      if (act === 'front') { p = K.frontFree(p, editN); save(); say(fill(L.broughtFront || '{item} is in front of the other decorations now.', { item: itemName(f.i) })); refresh(); }
      if (act === 'back') { p = K.removeFree(p, editN); save(); say(fill(L.removed || '{item} is off the house.', { item: itemName(f.i) })); closeEdit(); }
      if (act === 'copy') {
        const n = K.placeFree(withLent(), f.i, Math.min(K.VIEW - 20, f.x + 40), Math.min(K.VIEW - 20, f.y + 30), ul.holder, { s: f.s, r: f.r, t: f.t });
        if (!n) return say((p.free || []).length >= K.FREE_MAX ? L.freeFull || 'That is a lot of decorations. Remove some first.' : fill(L.allPlaced || 'No free {item} left.', { item: itemName(f.i) }));
        p = { ...p, free: n.free }; save(); openEdit(p.free[p.free.length - 1].n);
      }
      if (act === 'done') closeEdit();
    });
    // dragging a handle moves the decoration; the page does not scroll while a finger holds it
    let drag: any = null;
    slotsBox.addEventListener('pointerdown', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-free]'); if (!b || peek) return;
      const f = freeOf(Number(b.dataset.free)); if (!f) return;
      e.preventDefault(); b.setPointerCapture(e.pointerId);
      drag = { n: f.n, x0: e.clientX, y0: e.clientY, fx: f.x, fy: f.y, moved: false, el: b };
    });
    slotsBox.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const r = slotsBox.getBoundingClientRect();
      const dx = ((e.clientX - drag.x0) / r.width) * K.VIEW, dy = ((e.clientY - drag.y0) / r.height) * K.VIEW;
      if (Math.abs(dx) + Math.abs(dy) > 3) drag.moved = true;
      if (!drag.moved) return;
      p = K.updateFree(p, drag.n, { x: drag.fx + dx, y: drag.fy + dy });
      const f = freeOf(drag.n); drag.el.style.left = `${(f.x / K.VIEW) * 100}%`; drag.el.style.top = `${(f.y / K.VIEW) * 100}%`;
      moveG(f);   // only this decoration moves; the house is redrawn once, when the finger lets go
    });
    const endDrag = () => {
      if (!drag) return;
      const d = drag; drag = null;
      if (d.moved) { dragged = true; save(); setTimeout(() => { dragged = false; }, 0); refresh(); }
      else openEdit(d.n);
    };
    slotsBox.addEventListener('pointerup', endDrag);
    slotsBox.addEventListener('pointercancel', endDrag);
    // keyboard: a focused handle moves with the arrows, Delete takes it back
    slotsBox.addEventListener('keydown', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-free]'); if (!b) return;
      const n = Number(b.dataset.free), f = freeOf(n); if (!f) return;
      const step = e.shiftKey ? 30 : 8;
      const m: Record<string, any> = { ArrowLeft: { x: f.x - step }, ArrowRight: { x: f.x + step }, ArrowUp: { y: f.y - step }, ArrowDown: { y: f.y + step } };
      if (m[e.key]) { e.preventDefault(); p = K.updateFree(p, n, m[e.key]); save(); refresh(); (slotsBox.querySelector(`[data-free="${n}"]`) as HTMLElement)?.focus(); }
      if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); p = K.removeFree(p, n); save(); closeEdit(); }
    });

    // ---- the album: every decoration there is, the ones you have are in colour ----------------
    const albumBox = $<HTMLElement>('[data-ul-album]');
    const drawAlbum = () => {
      const seen = p.seen || {};
      const all = K.ITEM_IDS;
      $<HTMLElement>('[data-ul-album-count]').textContent = `${all.filter((i: string) => seen[i]).length} / ${all.length}`;
      if (!(albumBox.parentElement as HTMLDetailsElement).open) return;
      albumBox.innerHTML = '';
      for (const c of K.CATEGORIES) {
        const ids = all.filter((i: string) => (K.ITEMS as any)[i].cat === c);
        const sec = document.createElement('section');
        sec.innerHTML = `<h4></h4><ul></ul>`;
        sec.querySelector('h4')!.textContent = `${catName(c)} · ${ids.filter((i: string) => seen[i]).length}/${ids.length}`;
        const ul2 = sec.querySelector('ul')!;
        for (const id of ids) {
          const it = (K.ITEMS as any)[id], got = Boolean(seen[id]);
          const li = document.createElement('li'); li.className = `is-${it.rarity}${got ? '' : ' is-missing'}${it.holder ? ' is-holder' : ''}`;
          li.innerHTML = `<img src="${thumb(id)}" alt="" width="48" height="48" loading="lazy"><span></span>`;
          li.querySelector('span')!.textContent = got ? itemName(id) : (cfg.rarityNames[it.rarity] || it.rarity);
          li.title = got ? `${itemName(id)} · ${cfg.rarityNames[it.rarity] || it.rarity}` : (it.holder ? L.albumHolder || 'For holders' : L.albumMissing || 'Not found yet');
          ul2.appendChild(li);
        }
        albumBox.appendChild(sec);
      }
    };
    $<HTMLElement>('[data-ul-album-box]').addEventListener('toggle', drawAlbum);

    // ---- status, nights, stats -----------------------------------------------------------------
    const status = $<HTMLElement>('[data-ul-status]');
    const lightBtn = $<HTMLButtonElement>('[data-ul-light]');
    const dots = [...root.querySelectorAll<HTMLElement>('[data-ul-nights] li')];
    const statusText = (s: any) => {
      const S = cfg.status;
      if (peek) return S.peek || 'Night seven. The owl is on the roof.';
      if (s.first) return S.first || 'Your house is dark. Light the first lamp tonight.';
      if (s.missed) return S.missed || 'You missed a night. The house went dark. Start again from night one.';
      if (s.due) return fill(S.due || 'Night {n} of 7. Light up before the owl flies by.', { n: Math.min(s.night, K.NIGHTS) });
      if (s.landed && s.streak === K.NIGHTS) return S.landed || 'Seven nights in a row. The owl is on your roof.';
      if (s.landed) return fill(S.after || 'Night {n}. The owl stays on your roof.', { n: s.streak });
      return fill(S.lit || 'Night {n} of 7 is lit. The owl comes back tomorrow.', { n: s.streak });
    };
    const drawStatus = () => {
      const s = view();
      status.textContent = statusText(s);
      lightBtn.disabled = peek || !s.due;
      lightBtn.textContent = s.due ? (s.first ? L.lightFirst || L.light || 'Light up tonight' : L.light || 'Light up tonight') : L.lit || 'Lit for tonight';
      const filled = s.litTonight || (!s.missed && !s.first) ? Math.min(s.streak, K.NIGHTS) : 0;
      dots.forEach((d, i) => { d.classList.toggle('is-on', i < filled); d.classList.toggle('is-next', !peek && s.due && i === filled && i < K.NIGHTS); });
      const st = (k: string, v: string | number) => { root.querySelector(`[data-ul-stat="${k}"]`)!.textContent = String(v); };
      st('nights', p.nights); st('gifts', p.gifts); st('best', p.best);
      st('light', `${K.lightOf(h, shownPlaced(), levelShown(s), shownFree())}%`);
      ul.fire('ul:night', { text: peek ? fill(L.chip || 'Night {n}/7', { n: K.NIGHTS }) : s.first ? L.chipFirst || 'Light my house' : fill(L.chip || 'Night {n}/7', { n: Math.min(s.litTonight ? s.streak : s.night, K.NIGHTS) }), lit: s.litTonight || peek });
    };
    // ---- the story of the nights and tonight's event ------------------------------------------
    const ST = cfg.story;
    const itemsText = (b: Record<string, number>) => Object.entries(b).map(([id, n]) => `${n > 1 ? `${n} × ` : ''}${itemName(id)}`).join(', ');
    const eventText = (e: any) => (e && e.event && cfg.events[e.event] ? fill(cfg.events[e.event], {
      friend: p.neighbour?.name || cfg.setup.someone || 'Your neighbour', time: e.time || '', count: Object.keys(p.placed).length + (p.free || []).length,
      loan: e.loan ? itemName(e.loan).toLowerCase() : '', n: e.night,
    }) : '');
    const storyNight = (n: number) => (n <= K.NIGHTS ? (ST.nights || [])[n - 1] || '' : fill((ST.after || [])[(n - K.NIGHTS - 1) % Math.max(1, (ST.after || []).length)] || '', { n }));
    const drawStory = () => {
      const s = view(), e = K.tonightOf(p, today);
      let night = '', ev = '';
      if (peek) night = storyNight(K.NIGHTS);
      else if (s.litTonight) { night = storyNight(s.streak); ev = eventText(e); }
      else if (s.first) night = ST.first || '';
      else if (s.missed) night = ST.missed || '';
      else night = ST.due || '';
      $<HTMLElement>('[data-ul-story-night]').textContent = night;
      $<HTMLElement>('[data-ul-story-event]').textContent = ev;
      $<HTMLElement>('[data-ul-story]').hidden = !night && !ev;
    };
    const drawDiary = () => {
      const list = $<HTMLElement>('[data-ul-diary]');
      list.innerHTML = '';
      const entries = [...p.log].reverse().slice(0, 14);
      if (!entries.length) { list.innerHTML = `<li class="lt-note"></li>`; list.firstElementChild!.textContent = L.diaryEmpty || ''; return; }
      for (const e of entries) {
        const li = document.createElement('li');
        const d = new Date(`${e.date}T12:00:00`);
        li.innerHTML = '<b></b><span></span><p></p>';
        li.querySelector('b')!.textContent = `${d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })} · ${fill(L.diaryNight || 'Night {n}', { n: e.night })}`;
        li.querySelector('span')!.textContent = [e.gift ? fill(L.diaryGift || 'Gift: {item}', { item: itemName(e.gift) }) : '', e.bonus ? itemsText(e.bonus) : ''].filter(Boolean).join(' · ');
        li.querySelector('p')!.textContent = eventText(e);
        list.appendChild(li);
      }
    };
    const ctxNow = () => {
      const d = new Date(), wd = new Date(`${today}T12:00:00`).getDay();
      return { hour: pinnedDay ? 21 : d.getHours(), weekday: wd, moon: K.moonPhase(new Date(`${today}T21:00:00`)), allowed: Object.keys(cfg.events) };
    };
    const refresh = () => { drawHouse(); drawInv(); drawStatus(); drawStory(); drawDiary(); drawAlbum(); };

    // ---- lighting up tonight -------------------------------------------------------------------
    const dlg = $<HTMLDialogElement>('[data-ul-gift]');
    const openDialog = () => { if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open', ''); };
    const light = () => {
      if (!pinnedDay) today = K.dayKey();
      const res = K.lightTonight(p, today, Math.random, ul.holder, ctxNow());
      if (!res.gift) { refresh(); return res; }
      p = res.p; sel = ''; say(L.tipStart || '');
