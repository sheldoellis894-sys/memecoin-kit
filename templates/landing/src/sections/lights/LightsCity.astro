      if (size < namesTo && plan.districts.length) {
        g.font = `${W < 600 ? 13 : 16}px ${fontHead}`; g.textAlign = 'center'; g.textBaseline = 'middle';
        const a = clamp((namesTo - size) / 8, 0, 1), h = W < 600 ? 21 : 26;
        // a name keeps off the two marked houses, their labels and the buttons of the map: it steps aside, and is left
        // out when there is no free place. The largest districts are served first
        const keepOff = [starBox, meBox, starTagBox, meTagBox, ...buttons].filter(Boolean) as number[][];
        if (!plan.byHouses) plan.byHouses = [...plan.districts].sort((p, q) => q.n - p.n);
        for (const dd of plan.byHouses) {
          let x = sx(dd.x), y = sy(dd.y); if (x < 12 || x > W - 12 || y < 14 || y > H - 14) continue;
          const name = districtName(K.FAMILY_IDS[dd.d]), w = g.measureText(name).width + 16;
          if (w + 12 < W) x = clamp(x, w / 2 + 6, W - w / 2 - 6);
          const step = [[0, 0], [0, 1.5], [0, -1.5], [0, 3], [0, -3], [0.8, 0], [-0.8, 0], [0.8, 1.5], [-0.8, 1.5], [0.8, -1.5], [-0.8, -1.5], [0, 4.5], [0, -4.5]].find(([kx2, ky2]) => {
            const cx2 = x + kx2 * w, cy2 = y + ky2 * h, b = [cx2 - w / 2 - 4, cy2 - h / 2 - 2, cx2 + w / 2 + 4, cy2 + h / 2 + 2];
            return b[0] >= 2 && b[2] <= W - 2 && b[1] >= 2 && b[3] <= H - 2 && !keepOff.some((q) => hit(b, q)) && !nameBoxes.some((q) => hit(b, q));
          });
          if (!step) continue;
          x += step[0] * w; y += step[1] * h; nameBoxes.push([x - w / 2, y - h / 2, x + w / 2, y + h / 2]);
          g.fillStyle = `rgba(20,12,9,${(0.55 * a).toFixed(2)})`; rr(g, x - w / 2, y - h / 2, w, h, 8); g.fill();
          g.fillStyle = hexA(col.text, 0.8 * a); g.fillText(name, x, y + 1);
        }
      }

      // marks that are seen from any distance: the opened house, the brightest house of the night, the visitor's own house
      if (picked) ring(sx(picked.x), sy(picked.y), rOf + 2, col.primary);
      if (star && starSeen) {
        const [x, y] = starAt!;
        if (close) pill(L.cityStar || 'Brightest tonight', x, y - half + size * 0.12, col.primary, col.ink, clamp(size * 0.085, 9, 12));
        else {
          // a golden ring that breathes, and the label
          ring(x, y, rOf + 3, '#FFE9A6');
          if (!ul.calm) { const pulse = (t * 0.6 + 0.5) % 1; g.strokeStyle = '#FFE9A6'; g.lineWidth = 2; g.globalAlpha = (1 - pulse) * 0.8; g.beginPath(); g.arc(x, y, rOf + 8 + pulse * 14, 0, 6.3); g.stroke(); g.globalAlpha = 1; }
          if (starTagAt) tag(starText, starTagAt[0], starTagAt[1], col.primary, col.primary);
        }
      }
      if (me && meSeen) {
        const [x, y] = meAt!;
        if (close) pill(me.kind === 'you' ? L.you || 'You' : L.mine || 'Yours', x, y - half + size * 0.12, col.secondary, '#fff', clamp(size * 0.085, 9, 12));
        else {
          ring(x, y, rOf + 1, col.secondary);
          if (!ul.calm) { const pulse = (t * 0.9) % 1; g.strokeStyle = col.secondary; g.lineWidth = 2; g.globalAlpha = 1 - pulse; g.beginPath(); g.arc(x, y, rOf + 6 + pulse * 16, 0, 6.3); g.stroke(); g.globalAlpha = 1; }
          if (meTagAt) tag(meText, meTagAt[0], meTagAt[1], col.secondary, '#A9C4FF');
        }
      }
      if (picked) { const x = sx(picked.x), y = sy(picked.y); if (x < -20 || x > W + 20 || y < -20 || y > H + 20) closeCard(); else placeCard(); }
      cost = performance.now() - now0;
      // lights twinkle and the rings of the two marked houses breathe while they are on the screen
      if (moving || more || running) paint();
      else if (inView && !ul.calm && (size < 10.5 || (!close && (starSeen || meSeen)))) window.setTimeout(paint, 90);
    }

    // ---- size ------------------------------------------------------------------------------------
    function resize() {
      const r = map.getBoundingClientRect();
      if (r.width < 10 || r.height < 10) return;
      // two pixels for one are enough for the map: more only slows a phone down
      W = Math.round(r.width); H = Math.round(r.height); dpr = Math.min(2, window.devicePixelRatio || 1);
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      // the sheet of small houses is used while a house on the screen is at most half as large again as in the sheet
      atlasCell = dpr > 1.4 ? 44 : 28; sheetMax = (atlasCell / dpr) * 1.5;
      // room for the real pictures: less on a phone
      budget = W < 700 ? 6e6 : 16e6;
      measure();
      limits(); hold(); paint();
    }
    // where the buttons lie on the map, so the names of districts and the labels keep off them
    function measure() {
      const r = map.getBoundingClientRect();
      buttons = ['[data-ul-city-home]', '.lt-city-tools', '.lt-city-legend'].map((q) => root.querySelector<HTMLElement>(q)?.getBoundingClientRect()).filter((b) => b && b.width > 0)
        .map((b) => [b!.left - r.left - 6, b!.top - r.top - 6, b!.right - r.left + 6, b!.bottom - r.top + 6]);
      paint();
    }
    // a phone turned on its side: the city is laid out again, wider than tall (or back)
    // A map that showed the whole city shows the whole city in its new size too.
    const resized = () => {
      const whole = loaded && cam.s <= sMin * 1.02;
      resize();
      if (loaded && (W >= H * 1.15) !== wideNow) { build(lastRows, lastStar); resize(); }
      if (whole) { cam.x = 0; cam.y = 0; cam.s = sMin; hold(); paint(); }
    };
    if ('ResizeObserver' in window) new ResizeObserver(resized).observe(map); else addEventListener('resize', resized);

    // ---- the card of a house ---------------------------------------------------------------------
    const card = $<HTMLElement>('[data-ul-city-card]');
    let cardId = 0;
    function closeCard() { if (!picked) return; picked = null; card.hidden = true; paint(); }
    // next to the house on a wide map; on a phone the card lies along the bottom of the map (see the styles)
    function placeCard() {
      if (!picked || W < 600 || H < 400) { card.style.left = ''; card.style.top = ''; return; }
      const x = sx(picked.x), y = sy(picked.y), cw = card.offsetWidth, ch = card.offsetHeight;
      const right = x + 30 + cw < W - 8;
      const top = clamp(y - ch * 0.4, 8, Math.max(8, H - ch - 8));
      card.style.left = `${right ? x + 30 : x - 30 - cw}px`; card.style.top = `${top}px`;
      card.classList.toggle('is-left', !right); card.style.setProperty('--tail', `${clamp(y - top, 20, ch - 20)}px`);
    }
    async function showCard(sp: Spot) {
      picked = sp; const id = ++cardId;
      const art = $<HTMLElement>('[data-ul-city-card-art]');
      art.textContent = '';
      $<HTMLElement>('[data-ul-city-card-no]').textContent = sp.kind === 'house' ? sn4(sp.sn) : L.sample || 'Example';
      $<HTMLElement>('[data-ul-city-card-name]').textContent = sp.name;
      const nights = !lit(sp) ? L.cardDark || 'Dark tonight' : fill(sp.streak > K.NIGHTS ? L.cardRun || 'Night {n} in a row' : L.cardNight || 'Night {n} of {of}', { n: sp.streak, of: K.NIGHTS });
      $<HTMLElement>('[data-ul-city-card-line]').textContent = `${districtName(sp.family)} · ${nights} · ${fill(L.cardBright || '{light}% bright', { light: Math.round(sp.light) })}`;
      card.hidden = false; placeCard(); paint();
      const got = await fullOf(sp);
      if (id !== cardId || picked !== sp || !got) return;
      const h = K.houseOfP(got);
      const owl = landed(sp) ? { ...K.owlPlace(h, K.NIGHTS, true), href: cfg.owl.landed || K.owlPlaceholder('landed') } : null;
      art.innerHTML = K.houseSvg(h, got.placed, { free: got.free, ctx: drawCtx(), level: lit(sp) ? Math.min(K.NIGHTS, sp.streak) : 1, owl, id: `ulk${id}` });
    }
    $<HTMLButtonElement>('[data-ul-city-card-open]').addEventListener('click', () => { const sp = picked; if (sp) open(sp); });
    $<HTMLButtonElement>('[data-ul-city-card-go]').addEventListener('click', () => { const sp = picked; if (sp) flyTo(sp.x, sp.y + 0.08, Math.max(sNear, cam.s), 900); });

    // ---- fingers, mouse, keys --------------------------------------------------------------------
    const startBtn = $<HTMLButtonElement>('[data-ul-city-start]');
    let counted = false;
    const turnOn = () => {
      if (on) return; on = true; map.classList.add('is-on'); stats(); measure();
      if (!counted) { counted = true; window.dispatchEvent(new CustomEvent('ul:track', { detail: 'city' })); }
    };
    const turnOff = () => { if (!on) return; on = false; map.classList.remove('is-on'); pts.clear(); drag = null; pinch = null; glide = null; closeCard(); stats(); measure(); };
    startBtn.addEventListener('click', turnOn);
    // the way back for a finger: on a low screen the map fills it, and a finger on a switched-on map moves the map, not the page
    $<HTMLButtonElement>('[data-ul-city-off]').addEventListener('click', turnOff);
    const pts = new Map<number, { x: number; y: number }>();
    let drag: null | { x: number; y: number; moved: number; t: number; vx: number; vy: number } = null;
    let pinch: null | { d: number; s: number; ax: number; ay: number } = null;
    let lastTap = { t: 0, x: 0, y: 0 };
    const at = (e: PointerEvent | WheelEvent | MouseEvent) => { const r = cv.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
    cv.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      // a finger on a map that is not switched on scrolls the page; a tap switches it on (see "click" below)
      if (!on) { if (e.pointerType === 'mouse') turnOn(); else return; }
      const p = at(e); pts.set(e.pointerId, p);
      try { cv.setPointerCapture(e.pointerId); } catch { /* fine */ }
      fly = null; zoom = null; glide = null;
      if (pts.size === 1) drag = { x: p.x, y: p.y, moved: 0, t: performance.now(), vx: 0, vy: 0 };
      else if (pts.size === 2) { const [a, b] = [...pts.values()]; const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2; pinch = { d: Math.hypot(a.x - b.x, a.y - b.y) || 1, s: cam.s, ax: wx(mx), ay: wy(my) }; drag = null; closeCard(); }
    });
    cv.addEventListener('pointermove', (e) => {
      if (!pts.has(e.pointerId)) return;
      const p = at(e), was = pts.get(e.pointerId)!; pts.set(e.pointerId, p);
      if (pinch && pts.size >= 2) {
        const [a, b] = [...pts.values()]; const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
        cam.s = clamp(pinch.s * (Math.hypot(a.x - b.x, a.y - b.y) / pinch.d), sMin, sMax);
        cam.x = pinch.ax - (mx - W / 2) / cam.s; cam.y = pinch.ay - (my - H / 2) / cam.s; hold(); paint();
      } else if (drag) {
        const dx = p.x - was.x, dy = p.y - was.y, now = performance.now(), dt = Math.max(1, now - drag.t);
        drag.moved += Math.hypot(dx, dy); drag.t = now;
        drag.vx = drag.vx * 0.6 + (dx / dt) * 0.4; drag.vy = drag.vy * 0.6 + (dy / dt) * 0.4;
        if (drag.moved > 6) { cam.x -= dx / cam.s; cam.y -= dy / cam.s; hold(); paint(); }
      }
    });
    const lift = (e: PointerEvent) => {
      if (!pts.has(e.pointerId)) return;
      const p = at(e); pts.delete(e.pointerId);
      if (pinch) { if (pts.size < 2) { pinch = null; const rest = [...pts.values()][0]; drag = rest ? { x: rest.x, y: rest.y, moved: 99, t: performance.now(), vx: 0, vy: 0 } : null; } return; }
      if (!drag) return;
      const d = drag; drag = null;
      if (e.type === 'pointercancel') return;
      if (d.moved > 6) { if (!ul.calm && performance.now() - d.t < 90 && Math.hypot(d.vx, d.vy) > 0.25) { glide = { vx: d.vx, vy: d.vy }; paint(); } return; }
      tap(p.x, p.y);
    };
    cv.addEventListener('pointerup', lift); cv.addEventListener('pointercancel', lift);
    // a tap on the map that is not switched on yet (a finger): switches it on
    cv.addEventListener('click', () => { if (!on) turnOn(); });
    cv.addEventListener('wheel', (e) => {
      if (!on) return;
      const out = e.deltaY > 0, lim = out ? sMin : sMax;
      // at the end of the zoom the wheel scrolls the page again
      if (Math.abs(Math.log((zoom ? Math.exp(zoom.l) : cam.s) / lim)) < 0.01) { if (e.ctrlKey) e.preventDefault(); return; }
      e.preventDefault();
      const p = at(e); zoomBy(Math.exp(-clamp(e.deltaY, -240, 240) * (e.ctrlKey ? 0.012 : 0.0032)), p.x, p.y);
    }, { passive: false });
    cv.addEventListener('keydown', (e) => {
      const stepPx = 80;
      if (e.key === '+' || e.key === '=') zoomBy(1.6); else if (e.key === '-') zoomBy(1 / 1.6);
      else if (e.key === 'ArrowLeft') cam.x -= stepPx / cam.s; else if (e.key === 'ArrowRight') cam.x += stepPx / cam.s;
      else if (e.key === 'ArrowUp') cam.y -= stepPx / cam.s; else if (e.key === 'ArrowDown') cam.y += stepPx / cam.s;
      else if (e.key === 'Escape') { closeCard(); return; }
      else if (e.key === 'Enter') { tap(W / 2, H / 2); return; } else return;
      e.preventDefault(); turnOn(); closeCard(); hold(); paint();
    });
    function tap(px: number, py: number) {
      const now = performance.now();
      // a finger is not as exact as a light is small: from far away the nearest house within reach is taken
      const reach = Math.max(0.5, 16 / cam.s);
      let k = find(wx(px), wy(py));
      if (k < 0 && reach > 0.5) { let bd = reach; spots.forEach((sp2, i) => { if (sp2.kind === 'free') return; const d = Math.hypot(sp2.x - wx(px), sp2.y - wy(py)); if (d < bd) { bd = d; k = i; } }); }
      const sp = k < 0 ? null : spots[k];
      const twice = now - lastTap.t < 320 && Math.hypot(px - lastTap.x, py - lastTap.y) < 28;
      lastTap = { t: now, x: px, y: py };
      if (twice) { zoomBy(2.2, px, py); return; }
      if (!sp || sp.kind === 'free') { closeCard(); return; }
      if (sp.kind === 'you') { closeCard(); if (tp() < 62) flyTo(sp.x, sp.y + 0.08, sNear); else goBuild(); return; }
      // a tap on a light or a small house shows its card; a tap on a near house opens it
      if (tp() < 62) { if (picked === sp) closeCard(); else showCard(sp); } else open(sp);
    }
    root.querySelectorAll<HTMLButtonElement>('[data-ul-city-zoom]').forEach((b) => b.addEventListener('click', () => { turnOn(); zoomBy(Number(b.dataset.ulCityZoom) > 0 ? 1.9 : 1 / 1.9); }));
    $<HTMLButtonElement>('[data-ul-city-all]').addEventListener('click', () => { turnOn(); flyTo(0, 0, sMin, 900); });
    $<HTMLButtonElement>('[data-ul-city-home]').addEventListener('click', () => { turnOn(); const me = spots[0]; if (me) flyTo(me.x, me.y + 0.08, Math.max(sHome, Math.min(cam.s, sNear)), 800); });
    // the visitor's lot: to the street form above, where a house is put on the street
    function goBuild() {
      const form = document.querySelector<HTMLElement>('[data-ul-street-post]') || document.getElementById('house');
      form?.scrollIntoView({ block: 'center', behavior: ul.calm ? 'auto' : 'smooth' });
    }

    // ---- a house opened --------------------------------------------------------------------------
    const dlg = $<HTMLDialogElement>('[data-ul-city-view]');
    let vid = 0;
    async function open(sp: Spot) {
      const got = await fullOf(sp); if (!got) return;
      const h = K.houseOfP(got), f = sp.full || {};
      const owl = landed(sp) ? { ...K.owlPlace(h, K.NIGHTS, true), href: cfg.owl.landed || K.owlPlaceholder('landed') } : null;
      $<HTMLElement>('[data-ul-city-view-art]').innerHTML = K.houseSvg(h, got.placed, { free: got.free, ctx: { ...drawCtx(), time: K.timeOfDay() }, level: lit(sp) ? Math.min(K.NIGHTS, sp.streak) : 1, owl, id: `ulv${vid++}` });
      $<HTMLElement>('[data-ul-city-view-name]').textContent = sp.kind === 'house' ? `${sp.name} · ${sn4(sp.sn)}` : sp.name;
      const v = { streak: sp.streak, gifts: f.gifts ?? 0, best: f.best ?? sp.streak, light: sp.light };
      const line = !lit(sp) ? fill(L.lineDark || 'Went dark. Best run: {best} nights.', v) : fill(landed(sp) ? L.lineLanded || 'Night {streak} in a row · the owl is on the roof' : L.line || 'Night {streak} in a row · {gifts} owl visits', v);
      $<HTMLElement>('[data-ul-city-view-line]').textContent = `${line} · ${fill(L.best || 'best run {best}', v)} · ${sp.light}%`;
      if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open', '');
    }
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

    // ---- loading ---------------------------------------------------------------------------------
    // fresh = right after the visitor put a house on the street: past the 30-second cache, so the house is there at once
    async function load(fresh = false) {
      let rows: any[] = [], star = 0, ok = false, liveNow = false;
      if (cfg.endpoint) {
        try {
          const res = await fetch(urlFor(`map=1${fresh ? `&t=${Date.now()}` : ''}`), { headers: { accept: 'application/json' }, cache: fresh ? 'no-store' : 'default' });
          const out = await res.json(); liveNow = Boolean(out.live) && !out.error; ok = res.ok && !out.error;
          rows = Array.isArray(out.houses) ? out.houses : []; star = Number(out.star) || 0;
        } catch { /* the city is shown with the examples */ }
      }
      // the street did not answer this time: the city that is already on the map stays
      if (loaded && !ok) return;
      live = liveNow;
      const was = spots[0]?.kind;
      resize();
      build(rows, star);
      resize();
      // the map opens on the whole city; it goes to the visitor's house when the house has just been put on the street
      if (!loaded) { cam.x = 0; cam.y = 0; cam.s = sMin; }
      else if (was === 'you' && spots[0].kind === 'house') { cam.x = 0; cam.y = 0.08; cam.s = sHome; }
      loaded = true; hold(); paint();
    }
    ul.on('ul:street', (d: any) => { if (loaded) load(Boolean(d?.refresh)); });
    if ('IntersectionObserver' in window) {
      let started = false;
      new IntersectionObserver((es) => {
        const e = es[es.length - 1];
        if (e.isIntersecting && !started) { started = true; load(); }
        inView = e.isIntersecting && e.intersectionRatio > 0.05;
        if (e.intersectionRatio < 0.3) turnOff();
        if (inView) paint();
      }, { rootMargin: '300px 0px', threshold: [0, 0.05, 0.3, 0.6] }).observe(map);
    } else { inView = true; load(); }
    (document as any).fonts?.ready?.then(() => { for (const s of spots) s.labelFor = 0; paint(); });
    (root as any).city = { get spots() { return spots; }, get plan() { return plan; }, cam, flyTo, load, get on() { return on; }, get cost() { return cost; }, get picked() { return picked; }, tp, sx, sy };
  }
</script>
