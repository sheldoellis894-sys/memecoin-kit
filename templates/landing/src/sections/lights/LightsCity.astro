---
// The city: a map of every house on the street. From far away every house is a light in a round city with a river,
// ring roads and a district for every style of house; closer the lights turn into small houses, and close up into the
// real pictures with all their decorations. The visitor's own house stands in the middle of the city, so it is found
// at once. A tap on a light shows a card of the house; a tap on a near house opens it.
// Data: GET /api/street?map=1 (every house in a short row) and ?sn=… (full houses, asked for when the map comes
// close to them), see api/street.js. Where the houses stand: src/lib/lights-city.js.
// Texts: config.city = { kicker, title, lead, labels: { … }, districts: { style: name } }.
import { config, theme } from '../../lib/project';
import { streetCfg, houseCfg, owlImages, nightCtx } from '../../lib/lights';
import LtHead from './LtHead.astro';
const c: Record<string, any> = (config as any).city || {};
const l: Record<string, string> = c.labels || {};
const sl: Record<string, string> = streetCfg.labels || {};
const tc: Record<string, string> = (theme as any).colors || {};
const tl: Record<string, any> = (theme as any).lights || {};
const data = JSON.stringify({
  endpoint: streetCfg.enabled === false ? '' : streetCfg.endpoint || '/api/street', samples: streetCfg.samples || [], min: streetCfg.minReal ?? 3,
  owl: owlImages, ticker: config.ticker, night: nightCtx, labels: { ...sl, ...l }, styles: houseCfg.styleNames || {}, districts: c.districts || {},
  // the night of the map: the middle, the ring around it and the edge
  sky: Array.isArray(tl.citySky) && tl.citySky.length === 3 ? tl.citySky : ['#2A1A12', '#17101A', '#090812'],
  colors: { track: tl.track || '#2E2B5C', dim: tl.dim || '#4A4870', glow: tl.glow || '#FFB52E', cream: tl.cream || '#FFF3C4',
    pane: tl.pane || '#FFD36B', ink: tl.ink || '#141026', text: tc.text || '#FFFFFF', muted: tc.muted || '#BBBBCC', primary: tc.primary || '#FFB52E', secondary: tc.secondary || '#4A78D0', accent: tc.accent || '#FF7A1C' },
});
---
<section id="city" class="lt-sec lt-city-sec" data-ul-city={data}>
  <div class="lt-in">
    <LtHead kicker={c.kicker || 'The city'} title={c.title || 'The city we lit'} lead={c.lead || 'Every light is a house. Tap one to look inside'} />
    <p class="lt-city-stats" data-ul-city-stats aria-live="polite"></p>
    <div class="lt-city" data-ul-city-map data-ul-in>
      <canvas data-ul-city-canvas tabindex="0" role="img" aria-label={l.mapLabel || 'A map of the houses on the street'}></canvas>
      <button type="button" class="lt-btn lt-btn-small lt-city-home" data-ul-city-home>{l.home || 'Find my house'}</button>
      <div class="lt-city-tools">
        <button type="button" data-ul-city-zoom="1" aria-label={l.zoomIn || 'Closer'}>+</button>
        <button type="button" data-ul-city-zoom="-1" aria-label={l.zoomOut || 'Further'}>−</button>
        <button type="button" data-ul-city-all aria-label={l.all || 'The whole city'} title={l.all || 'The whole city'}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="lt-city-off" data-ul-city-off aria-label={l.off || 'Back to the page'} title={l.off || 'Back to the page'}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        </button>
      </div>
      <button type="button" class="lt-city-start" data-ul-city-start><span class="lt-flame" aria-hidden="true"></span>{l.start || 'Tap to walk the city'}</button>
      <div class="lt-city-card" data-ul-city-card hidden>
        <div class="lt-city-card-art" data-ul-city-card-art></div>
        <div class="lt-city-card-text">
          <span class="lt-city-card-no" data-ul-city-card-no></span>
          <h3 class="font-heading" data-ul-city-card-name></h3>
          <p data-ul-city-card-line></p>
          <div class="lt-city-card-acts">
            <button type="button" class="lt-btn lt-btn-small" data-ul-city-card-open>{l.cardOpen || 'Open the house'}</button>
            <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-city-card-go>{l.cardGo || 'Come closer'}</button>
          </div>
        </div>
      </div>
    </div>
    <p class="lt-city-legend" aria-hidden="true">
      <span><i class="is-lit"></i>{l.legendLit || 'Lit tonight'}</span>
      <span><i class="is-dark"></i>{l.legendDark || 'Dark tonight'}</span>
      <span><i class="is-owl"></i>{l.legendOwl || 'Seven nights, the owl landed'}</span>
    </p>
    <p class="lt-note lt-city-note" data-ul-city-note>{l.loading || 'Lighting the map…'}</p>
  </div>
  <dialog class="lt-view" data-ul-city-view aria-label={l.viewLabel || 'A house in the city'}>
    <div class="lt-view-in">
      <div data-ul-city-view-art></div>
      <p class="font-heading lt-view-name" data-ul-city-view-name></p>
      <p data-ul-city-view-line></p>
      <form method="dialog"><button class="lt-btn lt-btn-small">{l.close || 'Back to the city'}</button></form>
    </div>
  </dialog>
</section>

<script>
  import * as K from '../../lib/lights-kit.js';
  import * as C from '../../lib/lights-city.js';
  const root = document.querySelector<HTMLElement>('[data-ul-city]');
  const ul: any = (window as any).ul;
  const cv = root?.querySelector<HTMLCanvasElement>('[data-ul-city-canvas]');
  const g = cv?.getContext('2d');
  if (root && ul && cv && g) {
    const cfg = JSON.parse(root.dataset.ulCity!);
    const L: Record<string, string> = cfg.labels;
    const col: Record<string, string> = cfg.colors;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const fill = (t: string, v: Record<string, string | number>) => (t || '').replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
    const map = $<HTMLElement>('[data-ul-city-map]');
    const note = $<HTMLElement>('[data-ul-city-note]');
    const sn4 = (n: number) => `#${String(n).padStart(4, '0')}`;
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    const sky: string[] = Array.isArray(cfg.night?.sky) ? cfg.night.sky : ['#0B1030', '#1A2257', '#2C2A6B'];
    const veil: string = cfg.night?.veil || '#0A0F33';
    const drawCtx = () => ({ ticker: cfg.ticker, ...cfg.night, time: 'night' });
    // On the map a house is shown without most of the sky of its picture, so the house itself is larger: this part of the picture
    const CUT = { x: 0.12, y: 0.25, s: 0.76 };
    // the colour of the lights of every district (style of house), seen from far away
    const HUES = ['#FFB23E', '#FF8A1F', '#FFC861', '#F6A6C1', '#7FD7C4', '#FFD27A', '#FF9F6B', '#8FB4FF', '#B8E08A'];
    const districtName = (family: string) => String(cfg.districts[family] || cfg.styles[family] || family);

    // ---- the houses ------------------------------------------------------------------------------
    // kind: house = a real house, sample = an example, you = the visitor's lot while their house is not on the street, free = an empty lot
    type Spot = { k: number; x: number; y: number; kind: 'house' | 'sample' | 'you' | 'free'; sn: number; name: string; seed: number; family: string; wish: string; paint: string;
      light: number; streak: number; age: number; mine: boolean; star: boolean; mini: any; full: any; asked: boolean; bmp: HTMLCanvasElement | null; bmpPx: number; bmpSize: number; bmpAt: number;
      busy: boolean; used: number; owl: any; tw: number; turn: number; hue: number; slot: number; label: string; labelFor: number };
    let spots: Spot[] = [];
    let plan: any = { rings: [], avenues: [], river: null, districts: [], kx: 1, ky: 1, R: 3 };
    let find: (x: number, y: number) => number = () => -1;
    let ext = { x0: -4, x1: 4, y0: -4, y1: 4 };
    let real = 0, live = false, loaded = false;
    const lit = (s: Spot) => s.streak > 0;
    const landed = (s: Spot) => s.streak >= K.NIGHTS;
    const isHouse = (s: Spot) => s.kind === 'house' || s.kind === 'sample';
    const miniOf = (s: Spot) => (s.mini ||= C.miniHouse(s.seed, s.family, s.wish, s.paint, s.streak));
    const blank = (kind: Spot['kind']): Spot => ({ k: 0, x: 0, y: 0, kind, sn: 0, name: '', seed: 0, family: 'mumbai', wish: '', paint: '', light: 0, streak: 0, age: 999,
      mine: false, star: false, mini: null, full: null, asked: false, bmp: null, bmpPx: 0, bmpSize: 0, bmpAt: 0, busy: false, used: 0, owl: null, tw: Math.random() * 6.28, turn: 0, hue: 0, slot: -1, label: '', labelFor: 0 });

    let lastRows: any[] = [], lastStar = 0, wideNow = true;
    function build(rows: any[], star: number) {
      lastRows = rows; lastStar = star; wideNow = W >= H * 1.15;
      const houses: Partial<Spot>[] = [];
      for (const r of rows) {
        if (!Array.isArray(r) || !Number.isInteger(r[0]) || typeof r[1] !== 'string' || !Number.isInteger(r[2]) || !K.FAMILY_IDS[r[3]]) continue;
        houses.push({ kind: 'house', sn: r[0], name: r[1], seed: r[2], family: K.FAMILY_IDS[r[3]], wish: K.WISH_IDS[r[4]] || '', paint: typeof r[5] === 'string' ? r[5] : '',
          light: Number(r[6]) || 0, streak: Number(r[7]) || 0, age: Number(r[8]) || 0, star: r[0] === star });
      }
      real = houses.length;
      // the visitor's own house: the name it was put on the street with and its house number
      let mine: Partial<Spot> | null = null;
      if (ul.onStreet?.() && ul.houseName) {
        const name = ul.houseName(), no = ul.houseNo?.();
        mine = houses.find((h) => h.name === name && C.miniHouse(h.seed!, h.family!, h.wish, h.paint, 1).no === no) || null;
      }
      const others = houses.filter((h) => h !== mine);
      // until real houses arrive the examples of the street stand here too, marked as examples
      if (real < cfg.min) for (const s of cfg.samples as any[]) {
        const family = K.FAMILY_IDS.includes(s.style) ? s.style : 'mumbai', wish = K.WISH_IDS.includes(s.wish) ? s.wish : '';
        const placed = K.autoDecorate(s.seed, s.items ?? 6, false, family, wish);
        const streak = Number(s.streak) || 1;
        others.push({ kind: 'sample', name: String(s.name || ''), seed: s.seed, family, wish, streak, age: 0, light: K.lightOf(K.houseOf(s.seed, family, { wish }), placed, Math.min(K.NIGHTS, streak)),
          full: { sample: true, placed, streak, gifts: s.gifts ?? s.nights, best: s.best ?? streak, nights: s.nights, landings: s.landings ?? 0 } });
      }
      // a wide screen gets a city wider than tall, a phone a city taller than wide
      plan = C.cityPlan(others.map((h) => K.FAMILY_IDS.indexOf(h.family!)), { count: K.FAMILY_IDS.length, wide: wideNow });
      const old = new Map(spots.filter((s) => s.kind === 'house').map((s) => [s.sn, s]));
      const list: Spot[] = [{ ...blank(mine ? 'house' : 'you'), ...(mine || {}), mine: Boolean(mine) } as Spot];
      for (const p of plan.spots) list.push({ ...blank(p.i < 0 ? 'free' : others[p.i].kind!), ...(p.i < 0 ? {} : others[p.i]), x: p.x, y: p.y, turn: p.a } as Spot);
      let slot = 0;
      spots = list.map((s, k) => {
        s.k = k; s.hue = Math.max(0, K.FAMILY_IDS.indexOf(s.family)); if (isHouse(s)) s.slot = slot++;
        // a house that did not change keeps its picture
        const was = s.kind === 'house' ? old.get(s.sn) : null;
        if (was && was.seed === s.seed && was.family === s.family && was.streak === s.streak && was.light === s.light && was.name === s.name) { s.full = was.full; s.asked = was.asked; s.bmp = was.bmp; s.bmpPx = was.bmpPx; s.bmpSize = was.bmpSize; s.bmpAt = was.bmpAt; s.owl = was.owl; s.mini = was.mini; }
        return s;
      });
      used = spots.reduce((a, s) => a + (s.bmp ? s.bmpSize : 0), 0);
      find = C.cityFinder(spots);
      ext = { x0: -(plan.R + 2.5) * plan.kx, x1: (plan.R + 2.5) * plan.kx, y0: -(plan.R + 2.5) * plan.ky, y1: (plan.R + 2.5) * plan.ky };
      atlasDone = 0; atlasFor = ''; lightsFor = '';
      closeCard();
      stats();
    }

    function stats() {
      const hs = spots.filter((s) => s.kind === 'house');
      const box = $<HTMLElement>('[data-ul-city-stats]');
      box.textContent = '';
      const chip = (n: number, text: string) => { const el = document.createElement('span'); el.className = 'lt-city-chip'; const b = document.createElement('b'); b.textContent = n.toLocaleString('en-US').replace(/,/g, ' '); el.append(b, ` ${text}`); box.appendChild(el); };
      if (hs.length) {
        chip(hs.length, hs.length === 1 ? L.statHouse || 'house' : L.statHouses || 'houses');
        chip(hs.filter((s) => lit(s) && s.age < 24).length, L.statLit || 'lit tonight');
        chip(hs.filter(landed).length, L.statOwl || 'with the owl');
      }
      const some = real < cfg.min;
      note.textContent = [hs.length ? '' : live ? L.empty || 'No real houses yet. Yours can be the first.' : L.offline || 'The street is not open yet.',
        some ? L.citySamples || 'Houses marked Example show how the city will look. Real houses take their place' : '',
        on ? L.hintOn || 'Drag to move · pinch or scroll to come closer · your house is in the middle, new houses grow the city outwards' : ''].filter(Boolean).join(' ');
      $<HTMLButtonElement>('[data-ul-city-home]').textContent = spots[0]?.kind === 'you' ? L.homeFree || 'Find my lot' : L.home || 'Find my house';
    }

    // ---- the camera ------------------------------------------------------------------------------
    // x, y = the point of the city in the middle of the map (in lots); s = pixels in one lot
    const cam = { x: 0, y: 0, s: 60 };
    let W = 300, H = 300, dpr = 1;
    let sMin = 4, sMax = 400, sHome = 100, sNear = 180;
    const tp = () => cam.s * C.TILE;                       // the picture of a house, in pixels
    const sx = (x: number) => (x - cam.x) * cam.s + W / 2;
    const sy = (y: number) => (y - cam.y) * cam.s + H / 2;
    const wx = (px: number) => (px - W / 2) / cam.s + cam.x;
    const wy = (py: number) => (py - H / 2) / cam.s + cam.y;
    const limits = () => {
      let fit = Math.min(W / (ext.x1 - ext.x0), H / (ext.y1 - ext.y0));
      // a small city has the names of its districts around it: they stay clear of the buttons at the top and the bottom of the map
      if (plan.districts[0]?.out) fit = Math.min(fit, (H / 2 - 74) / ((plan.R + 1.1) * plan.ky));
      sHome = clamp(W * 0.3, 96, 150) / C.TILE;
      sNear = clamp(Math.min(W, H) * 0.5, 150, 250) / C.TILE;
      sMax = clamp(Math.min(W * 0.92, H * 0.74), 240, 560) / C.TILE;
      sMin = Math.min(fit, sHome);
    };
    const hold = () => {
      cam.s = clamp(cam.s, sMin, sMax);
      // the middle of the map never leaves the city
      cam.x = clamp(cam.x, ext.x0, ext.x1); cam.y = clamp(cam.y, ext.y0, ext.y1);
    };

    // moves: fly = to a place and a size in a set time; zoom = to a size, the point under the finger stays where it is
    let fly: null | { x0: number; y0: number; l0: number; x1: number; y1: number; l1: number; t0: number; dur: number } = null;
    let zoom: null | { l: number; ax: number; ay: number; px: number; py: number } = null;
    let glide: null | { vx: number; vy: number } = null;
    const flyTo = (x: number, y: number, s: number, dur = 700) => {
      zoom = null; glide = null; closeCard();
      if (ul.calm) { cam.x = x; cam.y = y; cam.s = s; hold(); paint(); return; }
      fly = { x0: cam.x, y0: cam.y, l0: Math.log(cam.s), x1: x, y1: y, l1: Math.log(clamp(s, sMin, sMax)), t0: performance.now(), dur }; paint();
    };
    const zoomBy = (f: number, px = W / 2, py = H / 2, smooth = true) => {
      fly = null; glide = null; closeCard();
      const base = zoom ? zoom.l : Math.log(cam.s);
      const l = clamp(base + Math.log(f), Math.log(sMin), Math.log(sMax));
      if (!smooth || ul.calm) { const ax = wx(px), ay = wy(py); cam.s = Math.exp(l); cam.x = ax - (px - W / 2) / cam.s; cam.y = ay - (py - H / 2) / cam.s; zoom = null; hold(); paint(); return; }
      zoom = { l, ax: zoom && zoom.px === px && zoom.py === py ? zoom.ax : wx(px), ay: zoom && zoom.px === px && zoom.py === py ? zoom.ay : wy(py), px, py }; paint();
    };
    let last = 0;
    function step(now: number) {
      const dt = Math.min(64, now - (last || now)); last = now;
      let moving = false;
      if (fly) {
        const t = clamp((now - fly.t0) / fly.dur, 0, 1), e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        cam.x = fly.x0 + (fly.x1 - fly.x0) * e; cam.y = fly.y0 + (fly.y1 - fly.y0) * e; cam.s = Math.exp(fly.l0 + (fly.l1 - fly.l0) * e);
        if (t >= 1) fly = null; else moving = true;
      } else if (zoom) {
        const cur = Math.log(cam.s), k = 1 - Math.exp(-dt / 85);
        const l = Math.abs(zoom.l - cur) < 0.004 ? zoom.l : cur + (zoom.l - cur) * k;
        cam.s = Math.exp(l); cam.x = zoom.ax - (zoom.px - W / 2) / cam.s; cam.y = zoom.ay - (zoom.py - H / 2) / cam.s;
        if (l === zoom.l) zoom = null; else moving = true;
      } else if (glide) {
        cam.x -= (glide.vx * dt) / cam.s; cam.y -= (glide.vy * dt) / cam.s;
        const f = Math.exp(-dt / 260); glide.vx *= f; glide.vy *= f;
        if (Math.hypot(glide.vx, glide.vy) < 0.02) glide = null; else moving = true;
      }
      hold();
      return moving;
    }

    // ---- small pictures --------------------------------------------------------------------------
    const hexA = (hex: string, a: number) => { const n = parseInt(hex.slice(1), 16); return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`; };
    const rr = (c2: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) => {
      const q = Math.min(r, w / 2, h / 2); c2.beginPath(); c2.moveTo(x + q, y); c2.arcTo(x + w, y, x + w, y + h, q); c2.arcTo(x + w, y + h, x, y + h, q); c2.arcTo(x, y + h, x, y, q); c2.arcTo(x, y, x + w, y, q); c2.closePath();
    };
    const soft = (stops: [number, string][], px = 64) => { const c2 = document.createElement('canvas'); c2.width = c2.height = px; const q = c2.getContext('2d')!; const gr = q.createRadialGradient(px / 2, px / 2, 0, px / 2, px / 2, px / 2);
      for (const [o, c3] of stops) gr.addColorStop(o, c3); q.fillStyle = gr; q.fillRect(0, 0, px, px); return c2; };
    // the glow of a lit house and of a house the owl landed on, seen from far away
    const glowDot = soft([[0, 'rgba(255,150,50,.5)'], [0.5, 'rgba(255,140,40,.16)'], [1, 'rgba(255,140,40,0)']]);
    const glowGold = soft([[0, 'rgba(255,215,120,.62)'], [0.5, 'rgba(255,190,80,.2)'], [1, 'rgba(255,170,60,0)']]);
    // the night of the map: warm in the middle of the city, dark blue at its edge, drawn once and stretched under the map
    const night = soft([[0, cfg.sky[0]], [0.45, cfg.sky[1]], [1, cfg.sky[2]]], 256);
    // a light: a small square with round corners, one for every colour
    const chip = (color: string) => { const c2 = document.createElement('canvas'); c2.width = c2.height = 24; const q = c2.getContext('2d')!; q.fillStyle = color; rr(q, 1, 1, 22, 22, 6); q.fill(); return c2; };
    const chips = HUES.map(chip), chipDark = chip('#3D2F29'), chipGold = chip('#FFE9A6'), chipFree = chip('#2A211D');
    // The lights of the whole city as one picture: every house a small square turned a little, lit in the colour of its
    // district with a glow around it, dark when it is not lit, cream with a ring when the owl landed on it. Drawn once
    // (a few hundred houses a frame, so the city lights up before the eyes) and then only stretched: two thousand lights
    // cost one paste a frame.
    let lights: HTMLCanvasElement | null = null, lightsFor = '', lightsAt = 0, lightsPass = 0, litList: Spot[] = [];
    function lightsStep() {
      const ew = ext.x1 - ext.x0, eh = ext.y1 - ext.y0;
      const k = Math.min(11.5 * dpr, 2400 / Math.max(ew, eh));       // pixels of the picture in one lot
      const key = `${spots.length}:${real}:${k.toFixed(2)}`;
      if (lightsFor !== key) {
        lights ||= document.createElement('canvas');
        lights.width = Math.max(1, Math.round(ew * k)); lights.height = Math.max(1, Math.round(eh * k));
        lightsFor = key; lightsAt = 0; lightsPass = 0; litList = spots.filter((s) => isHouse(s) && lit(s));
      }
      if (lightsPass > 1) return false;
      const q = lights!.getContext('2d')!;
      const d = 0.78 * C.TILE;
      let done = 0;
      for (; lightsAt < spots.length && done < 420; lightsAt++) {
        const sp = spots[lightsAt]; if (sp.kind === 'you') continue;
        const x = (sp.x - ext.x0) * k, y = (sp.y - ext.y0) * k;
        if (lightsPass === 0) {
          // first the glow of every lit house
          if (!isHouse(sp) || !lit(sp)) continue;
          const r = C.TILE * 1.75 * (0.7 + (sp.light / 100) * 0.6) * (landed(sp) ? 1.7 : 1) * k;
          q.setTransform(1, 0, 0, 1, 0, 0); q.globalCompositeOperation = 'lighter'; q.globalAlpha = landed(sp) ? 1 : 0.55 + (sp.light / 100) * 0.45;
          q.drawImage(landed(sp) ? glowGold : glowDot, x - r, y - r, r * 2, r * 2);
        } else {
          const free = sp.kind === 'free', k2 = (landed(sp) ? 1.35 : free ? 0.7 : 1.05) * d * k, cs = Math.cos(sp.turn), sn = Math.sin(sp.turn);
          q.globalCompositeOperation = 'source-over'; q.globalAlpha = free ? 0.8 : 1;
          q.setTransform(cs, sn, -sn, cs, x, y);
          q.drawImage(free ? chipFree : !lit(sp) ? chipDark : landed(sp) ? chipGold : chips[sp.hue % chips.length], -k2 / 2, -k2 / 2, k2, k2);
