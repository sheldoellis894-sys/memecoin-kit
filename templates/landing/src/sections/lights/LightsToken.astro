---
// The token as a house front: every line of the tokenomics is a window that lights up as it scrolls into view.
import { config } from '../../lib/project';
import { lights } from '../../lib/lights';
import LtHead from './LtHead.astro';
const t = lights.token || {};
const tk = config.tokenomics || { items: [] };
const ca: string = config.ca || '';
---
<section id="token" class="lt-sec">
  <div class="lt-in">
    <LtHead kicker={t.kicker} title={t.title} lead={t.lead} />
    <div class="lt-facade" data-ul-in>
      <div class="lt-facade-top">
        <p class="lt-label">{t.supply || 'Supply'}</p>
        <p class="lt-facade-supply font-heading">{tk.supply}</p>
      </div>
      <ul class="lt-facade-grid">
        {tk.items.map((it: { label: string; value: string }, i: number) => (
          <li class="lt-pane" style={`--i:${i}`}>
            <span class="lt-pane-value font-heading">{it.value}</span>
            <span class="lt-pane-label">{it.label}</span>
          </li>
        ))}
      </ul>
      <div class="lt-ca">
        <p class="lt-label">{t.ca || 'Contract address'}</p>
        {ca ? (
          <div class="lt-row">
            <code class="lt-ca-code" data-ul-ca>{ca}</code>
            <button type="button" class="lt-btn lt-btn-small" data-ul-ca-copy data-done={t.copied || 'Copied'}>{t.copy || 'Copy'}</button>
          </div>
        ) : (
          <p class="lt-ca-none">{t.noCa || 'No address yet. Any address before launch is fake.'}</p>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-ul-ca-copy]').forEach((b) => b.addEventListener('click', async () => {
    const code = b.parentElement!.querySelector('[data-ul-ca]')!.textContent!.trim();
    const label = b.textContent;
    try { await navigator.clipboard.writeText(code); b.textContent = b.dataset.done || 'Copied'; }
    catch { const r = document.createRange(); r.selectNodeContents(b.parentElement!.querySelector('[data-ul-ca]')!); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
    setTimeout(() => { b.textContent = label; }, 1600);
  }));
</script>
