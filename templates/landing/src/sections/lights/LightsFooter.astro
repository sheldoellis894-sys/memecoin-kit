---
// Footer of the "lights" layout: name, links and the short note.
import { config, asset } from '../../lib/project';
import { lights } from '../../lib/lights';
const f = lights.footer || {};
// X and Telegram are always in the row: without a link they are dimmed placeholders ("Soon") until the account exists
const soon = f.soon || 'Soon';
const links = [
  { label: 'X', url: config.links.x || '', icon: 'x' },
  { label: 'Telegram', url: config.links.telegram || '', icon: 'tg' },
  config.links.launch && { label: f.launchLabel || 'Launchpad', url: config.links.launch, track: 'buy' },
  config.links.pumpfun && { label: 'pump.fun', url: config.links.pumpfun },
  config.links.dexscreener && { label: 'DexScreener', url: config.links.dexscreener },
].filter(Boolean) as { label: string; url: string; icon?: string; track?: string }[];
---
<footer class="lt-footer">
  <div class="lt-in lt-footer-in">
    <div class="lt-footer-brand">
      <img src={asset(config.assets.logo)} alt="" width="56" height="56" loading="lazy" />
      <div>
        <p class="font-heading lt-footer-name">{config.name} <span class="font-ticker">${config.ticker}</span></p>
        <p class="lt-footer-tag">{f.tag}</p>
      </div>
    </div>
    <ul class="lt-footer-links">
      {links.map((l) => {
        const icon = l.icon === 'tg' && <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M21 4 3.6 11.2c-.8.3-.8 1.4 0 1.7l4.3 1.5 1.6 5c.2.8 1.2 1 1.8.4l2.4-2.3 4.1 3c.7.5 1.6.1 1.8-.7L22.5 5.1c.2-.9-.7-1.5-1.5-1.1ZM9.2 14.1l9-6.5-7.4 7.8-.3 3Z" fill="currentColor"/></svg>;
        return l.url
          ? <li><a class="lt-btn lt-btn-small lt-btn-ghost" href={l.url} target="_blank" rel="noopener noreferrer" data-ul-track={l.track}>{icon}{l.label}</a></li>
          : <li><span class="lt-btn lt-btn-small lt-btn-ghost is-soon" title={soon}>{icon}{l.label} <small>· {soon.toLowerCase()}</small></span></li>;
      })}
    </ul>
    <p class="lt-footer-note">{f.note}</p>
  </div>
</footer>
