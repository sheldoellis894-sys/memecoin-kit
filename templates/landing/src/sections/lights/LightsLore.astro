---
// The lore in three cards and the rules of the seven nights. Without cards (config lore.cards: []) the heading and the
// rules stand side by side on a wide screen.
import { lights } from '../../lib/lights';
import LtHead from './LtHead.astro';
const l = lights.lore || {};
const cards: { title: string; text: string }[] = l.cards || [];
const rules: string[] = l.rules || [];
---
<section id="lore" class="lt-sec">
  <div class:list={['lt-in', !cards.length && rules.length > 0 && 'lt-lore-duo']}>
    <LtHead kicker={l.kicker} title={l.title} lead={l.lead} />
    {cards.length > 0 && <ol class="lt-cards">
      {cards.map((c, i) => (
        <li class="lt-card" style={`--i:${i}`} data-ul-in>
          <span class="lt-card-no font-heading">{i + 1}</span>
          <h3 class="font-heading">{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ol>}
    {rules.length > 0 && (
      <div class="lt-rules-strip" data-ul-in>
        <p class="lt-rules-title font-heading">{l.rulesTitle || 'The seven nights'}</p>
        <ol class="lt-lore-nights" aria-hidden="true">
          {Array.from({ length: 7 }, (_, i) => (
            <li style={`--i:${i}`}><span class="lt-step-lamp"><span class="lt-step-flame"><b class="font-heading">{i + 1}</b></span><span class="lt-step-bowl"></span></span></li>
          ))}
        </ol>
        <ul>{rules.map((r, i) => <li><span class="lt-night-dot" style={`--i:${i}`} aria-hidden="true"></span>{r}</li>)}</ul>
      </div>
    )}
  </div>
</section>
