---
// Pictures of the owl in arched windows of a night house; a tap opens the picture large.
import { config, asset } from '../../lib/project';
import { lights } from '../../lib/lights';
import LtHead from './LtHead.astro';
const g = lights.gallery || {};
const items: { src: string; alt: string; note?: string }[] = config.gallery || [];
// One row of windows that drifts sideways like a ribbon and never ends: the row is drawn twice, and the script moves it
// along and jumps back by one row when the first copy has gone by. A finger or the wheel scrolls it too; a mouse over it
// stops the drift. Without motion (reduced motion) it is a plain row that scrolls by hand.
const ribbon = items.length > 2;
const rows = ribbon ? [items, items] : [items];
---
{items.length > 0 && (
<section id="gallery" class="lt-sec">
  <div class="lt-in">
    <LtHead kicker={g.kicker} title={g.title} lead={g.lead} />
    <div class:list={['lt-ribbon', ribbon && 'is-ribbon']} data-ul-ribbon={ribbon ? '' : undefined} data-ul-in>
      <ul class="lt-gallery">
        {rows.map((row, r) => row.map((it, i) => (
          <li style={`--i:${i}`} aria-hidden={r > 0 ? 'true' : undefined} data-ul-dup={r > 0 ? '' : undefined}>
            <button type="button" class="lt-window" data-ul-pic-open={i} tabindex={r > 0 ? -1 : undefined} aria-label={`${g.open || 'Open'}: ${it.alt}`}>
              <img src={asset(it.src)} alt={r > 0 ? '' : it.alt} width="640" height="640" loading="lazy" decoding="async" />
            </button>
            {it.note && <p class="lt-window-note">{it.note}</p>}
          </li>
        )))}
      </ul>
    </div>
  </div>
  <dialog class="lt-view lt-view-pic" data-ul-lightbox aria-label={g.title || 'Picture'}>
    <div class="lt-view-in">
      <img data-ul-lightbox-img alt="" width="1080" height="1080" />
      <p data-ul-lightbox-note></p>
      <div class="lt-actions lt-actions-center">
        <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-lb="-1">{g.prev || 'Back'}</button>
        <button type="button" class="lt-btn lt-btn-small lt-btn-ghost" data-ul-lb="1">{g.next || 'Next'}</button>
        <form method="dialog"><button class="lt-btn lt-btn-small">{g.close || 'Close'}</button></form>
      </div>
    </div>
  </dialog>
</section>
)}

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-ul-lightbox]');
  if (dlg) {
    // the first copy of the row opens the big picture; the second copy is only there for the ribbon to loop
    const btns = [...document.querySelectorAll<HTMLButtonElement>('li:not([data-ul-dup]) > [data-ul-pic-open]')];
    const img = dlg.querySelector<HTMLImageElement>('[data-ul-lightbox-img]')!;
    const note = dlg.querySelector<HTMLElement>('[data-ul-lightbox-note]')!;
    let at = 0;
    const show = (i: number) => {
      at = (i + btns.length) % btns.length;
      const src = btns[at].querySelector('img')!;
      img.src = src.currentSrc || src.src; img.alt = src.alt;
      note.textContent = btns[at].parentElement!.querySelector('.lt-window-note')?.textContent || src.alt;
    };
    const open = (i: number) => { show(i); if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open', ''); };
    btns.forEach((b, i) => b.addEventListener('click', () => open(i)));
    document.querySelectorAll<HTMLButtonElement>('li[data-ul-dup] > [data-ul-pic-open]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.ulPicOpen))));
    dlg.querySelectorAll<HTMLButtonElement>('[data-ul-lb]').forEach((b) => b.addEventListener('click', () => show(at + Number(b.dataset.ulLb))));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(at + 1); if (e.key === 'ArrowLeft') show(at - 1); });
  }

  // The ribbon: the row drifts to the left on its own, 28 px a second. It is a normal scrolling box, so a finger, a trackpad or
  // the wheel move it as usual; the drift waits while the mouse is over it, while a finger holds it and for two seconds
  // after a scroll by hand. The row is drawn twice: past the end of the first copy it jumps back by one copy, and before
  // the start it jumps forward, so it never ends in either direction. A tap that was really a swipe does not open the picture.
  const rib = document.querySelector<HTMLElement>('[data-ul-ribbon]');
  if (rib && document.documentElement.classList.contains('ul-motion')) {
    const SPEED = 28;
    let hover = false, held = false, handAt = 0, seen = true, raf = 0, last = 0, pos = 0, expected = -1;
    const half = () => rib.scrollWidth / 2;
    // scroll events come later than the write, so "ours" is known by the value, not by timing
    const setLeft = (v: number) => { rib.scrollLeft = v; expected = rib.scrollLeft; };
    const wrap = () => { const h = half(); if (!h) return; if (rib.scrollLeft >= h) setLeft(rib.scrollLeft - h); else if (rib.scrollLeft < 1 && handAt) setLeft(rib.scrollLeft + h); };
    const step = (now: number) => {
      raf = 0;
      const dt = Math.min(64, now - (last || now)) / 1000; last = now;
      const idle = !hover && !held && now - handAt > 2000 && seen && !document.hidden;
      if (idle) { pos += SPEED * dt; if (pos >= 1) { const n = Math.floor(pos); pos -= n; setLeft(rib.scrollLeft + n); wrap(); } }
      else pos = 0;
      if (seen && !document.hidden) raf = requestAnimationFrame(step); else last = 0;
    };
    const go = () => { if (!raf && seen && !document.hidden) { last = 0; raf = requestAnimationFrame(step); } };
    rib.addEventListener('scroll', () => { if (Math.abs(rib.scrollLeft - expected) > 1.5) { handAt = performance.now(); wrap(); } }, { passive: true });
    rib.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    rib.addEventListener('pointerleave', () => { hover = false; });
    rib.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') held = true; }, { passive: true });
    for (const ev of ['pointerup', 'pointercancel']) addEventListener(ev, () => { if (held) { held = false; handAt = performance.now(); } }, { passive: true });
    rib.addEventListener('focusin', () => { hover = true; }); rib.addEventListener('focusout', () => { hover = false; });
    // a swipe over a window is a scroll, not a tap
    let downX = 0; rib.addEventListener('pointerdown', (e) => { downX = e.clientX; }, { passive: true, capture: true });
    rib.addEventListener('click', (e) => { if (Math.abs(e.clientX - downX) > 8) { e.stopPropagation(); e.preventDefault(); } }, true);
    new IntersectionObserver(([en]) => { seen = en.isIntersecting; go(); }, { rootMargin: '100px 0px' }).observe(rib);
    document.addEventListener('visibilitychange', go);
    go();
  }
</script>
