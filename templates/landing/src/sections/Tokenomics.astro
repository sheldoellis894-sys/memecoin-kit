---
import { config } from '../lib/project';
import SectionTitle from '../components/SectionTitle.astro';
import ContractAddress from '../components/ContractAddress.astro';
const { tokenomics } = config;
---
<section id="tokenomics" data-reveal class="scroll-mt-20 px-4 py-24">
  <div class="mx-auto max-w-6xl">
    <SectionTitle kicker="Simple and fair">Tokenomics</SectionTitle>
    <div class="mb-8 rounded-card border border-accent/40 bg-accent/10 p-8 text-center">
      <p class="mb-2 font-black uppercase tracking-[0.2em] text-muted">Total supply</p>
      <p class="font-heading text-5xl text-primary md:text-7xl">{tokenomics.supply}</p>
    </div>
    <div class="mb-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {tokenomics.items.map((it) => (
        <div class="rounded-card border border-white/10 bg-surface p-6 text-center">
          <p class="mb-1 font-heading text-3xl text-secondary">{it.value}</p>
          <p class="text-muted">{it.label}</p>
        </div>
      ))}
    </div>
    <div class="flex justify-center"><ContractAddress /></div>
  </div>
</section>
