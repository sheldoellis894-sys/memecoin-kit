---
import { config, asset } from '../lib/project';
const links = [
  { label: 'X', url: config.links.x },
  { label: 'Telegram', url: config.links.telegram },
  { label: 'pump.fun', url: config.links.pumpfun },
  { label: 'DexScreener', url: config.links.dexscreener },
].filter((l) => l.url);
---
<footer class="border-t border-white/10 px-4 py-14">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 text-center">
    <img src={asset(config.assets.logo)} alt={config.name} class="h-20 w-20 rounded-full" loading="lazy" />
    <p class="font-heading text-3xl text-primary">{config.name} <span class="font-ticker text-secondary">${config.ticker}</span></p>
    <nav class="flex flex-wrap justify-center gap-3">
      {links.map((l) => (
        <a href={l.url} target="_blank" rel="noopener noreferrer"
           class="rounded-btn border border-white/15 px-5 py-2 font-bold text-ink transition hover:border-primary hover:text-primary">{l.label}</a>
      ))}
    </nav>
    <p class="max-w-2xl text-sm text-muted">{config.disclaimer}</p>
    <p class="text-xs text-muted/70">© {new Date().getFullYear()} {config.name}</p>
  </div>
</footer>
