---
import { config, ui, asset } from '../lib/project';
import SectionTitle from '../components/SectionTitle.astro';
---
<section id="roadmap" data-reveal class="scroll-mt-20 px-4 py-24">
  <div class="mx-auto max-w-6xl">
    <SectionTitle kicker={ui.roadmapKicker}>Roadmap</SectionTitle>
    <div class="grid gap-6 md:grid-cols-3">
      {config.roadmap.map((r) => (
        <div class="rounded-card border border-white/10 bg-surface p-6">
          <p class="mb-1 font-black uppercase tracking-[0.2em] text-accent">{r.phase}</p>
          <h3 class="mb-4 text-3xl text-primary">{r.title}</h3>
          <ul class="space-y-2 text-ink/90">
            {r.items.map((i) => (
              <li class="flex gap-2">
                {ui.iconImage
                  ? <img src={asset(ui.iconImage)} alt="" class="mt-1 h-5 w-5 shrink-0 object-contain" />
                  : <span class="text-secondary">{ui.icon}</span>}
                {i}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
