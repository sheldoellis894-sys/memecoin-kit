---
// The page = the list of sections from the chosen layout (src/layouts/<name>.json).
// To add a new section type: create it in src/sections/ and register it below.
import Base from '../components/Base.astro';
import { layout } from '../lib/project';
import Header from '../sections/Header.astro';
import Hero from '../sections/Hero.astro';
import About from '../sections/About.astro';
import HowToBuy from '../sections/HowToBuy.astro';
import Tokenomics from '../sections/Tokenomics.astro';
import Gallery from '../sections/Gallery.astro';
import Roadmap from '../sections/Roadmap.astro';
import Footer from '../sections/Footer.astro';
import Marquee from '../sections/Marquee.astro';
import DigGame from '../sections/DigGame.astro';
import Boot from '../sections/Boot.astro';
import HeroArcade from '../sections/HeroArcade.astro';
import ChaseGame from '../sections/ChaseGame.astro';
// Layout "contract": paper sheets on a desk
import PaperFx from '../sections/paper/PaperFx.astro';
import PaperTabs from '../sections/paper/PaperTabs.astro';
import BossGrow from '../sections/paper/BossGrow.astro';
import PaperCover from '../sections/paper/PaperCover.astro';
import PaperClauses from '../sections/paper/PaperClauses.astro';
import FeedGame from '../sections/paper/FeedGame.astro';
import PaperDuties from '../sections/paper/PaperDuties.astro';
import PaperPayroll from '../sections/paper/PaperPayroll.astro';
import DeskPhotos from '../sections/paper/DeskPhotos.astro';
import PaperOrders from '../sections/paper/PaperOrders.astro';
import PaperSign from '../sections/paper/PaperSign.astro';
import PaperFooter from '../sections/paper/PaperFooter.astro';
// Layout "delivery": a food-delivery app on a phone screen
import AppShell from '../sections/app/AppShell.astro';
import AppHome from '../sections/app/AppHome.astro';
import AppMap from '../sections/app/AppMap.astro';
import AppCourier from '../sections/app/AppCourier.astro';
import AppChat from '../sections/app/AppChat.astro';
import StopGame from '../sections/app/StopGame.astro';
import AppRate from '../sections/app/AppRate.astro';
import AppCheckout from '../sections/app/AppCheckout.astro';
import AppReceipt from '../sections/app/AppReceipt.astro';
import AppStories from '../sections/app/AppStories.astro';
import AppNext from '../sections/app/AppNext.astro';
import AppOrder from '../sections/app/AppOrder.astro';
import AppFooter from '../sections/app/AppFooter.astro';
// Layout "press": the site is a printing press, the visitor is a sheet of paper going through it
import PressShell from '../sections/press/PressShell.astro';
import PressHero from '../sections/press/PressHero.astro';
import PressAbout from '../sections/press/PressAbout.astro';
import PressStudio from '../sections/press/PressStudio.astro';
import PressWorkout from '../sections/press/PressWorkout.astro';
import PressInk from '../sections/press/PressInk.astro';
import PressLine from '../sections/press/PressLine.astro';
import PressShifts from '../sections/press/PressShifts.astro';
import PressBuy from '../sections/press/PressBuy.astro';
import PressFooter from '../sections/press/PressFooter.astro';
// Layout "vault": the site is a vault door with ten locks, every section is one lock
import VaultShell from '../sections/vault/VaultShell.astro';
import VaultHero from '../sections/vault/VaultHero.astro';
import VaultWhy from '../sections/vault/VaultWhy.astro';
import VaultSplit from '../sections/vault/VaultSplit.astro';
import VaultHolders from '../sections/vault/VaultHolders.astro';
import VaultSteps from '../sections/vault/VaultSteps.astro';
import VaultRack from '../sections/vault/VaultRack.astro';
import VaultCells from '../sections/vault/VaultCells.astro';
import VaultPlan from '../sections/vault/VaultPlan.astro';
import VaultRules from '../sections/vault/VaultRules.astro';
import VaultDoor from '../sections/vault/VaultDoor.astro';
import VaultFooter from '../sections/vault/VaultFooter.astro';

const registry: Record<string, any> = {
  header: Header, hero: Hero, about: About, howToBuy: HowToBuy,
  tokenomics: Tokenomics, gallery: Gallery, roadmap: Roadmap, footer: Footer, marquee: Marquee, digGame: DigGame,
  boot: Boot, heroArcade: HeroArcade, chaseGame: ChaseGame,
  paperFx: PaperFx, paperTabs: PaperTabs, bossGrow: BossGrow, paperCover: PaperCover, paperClauses: PaperClauses,
  feedGame: FeedGame, paperDuties: PaperDuties, paperPayroll: PaperPayroll, deskPhotos: DeskPhotos,
  paperOrders: PaperOrders, paperSign: PaperSign, paperFooter: PaperFooter,
  appShell: AppShell, appHome: AppHome, appMap: AppMap, appCourier: AppCourier, appChat: AppChat, stopGame: StopGame,
  appRate: AppRate, appCheckout: AppCheckout, appReceipt: AppReceipt, appStories: AppStories, appNext: AppNext,
  appOrder: AppOrder, appFooter: AppFooter,
  pressShell: PressShell, pressHero: PressHero, pressAbout: PressAbout, pressStudio: PressStudio, pressWorkout: PressWorkout,
  pressInk: PressInk, pressLine: PressLine, pressShifts: PressShifts, pressBuy: PressBuy, pressFooter: PressFooter,
  vaultShell: VaultShell, vaultHero: VaultHero, vaultWhy: VaultWhy, vaultSplit: VaultSplit, vaultHolders: VaultHolders,
  vaultSteps: VaultSteps, vaultRack: VaultRack, vaultCells: VaultCells, vaultPlan: VaultPlan, vaultRules: VaultRules,
  vaultDoor: VaultDoor, vaultFooter: VaultFooter,
};
const unknown = layout.sections.filter((s) => !registry[s]);
if (unknown.length) throw new Error(`Layout "${layout.name}": неизвестные секции: ${unknown.join(', ')}`);
---
<Base>
  {layout.sections.map((name) => { const Section = registry[name]; return <Section />; })}
</Base>
